                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-26" style="rounded=1;html=1;strokeWidth=4.8;strokeColor=#37474F;exitX=0.75;exitY=1;entryX=0.5;entryY=0;fontSize=35;" edge="1" parent="1" source="PYzQb3dAYdrDX_y4Gtt2-2" target="PYzQb3dAYdrDX_y4Gtt2-16">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-27" value="&lt;font style=&quot;color: rgb(120, 144, 156);&quot;&gt;&lt;b&gt;vs&lt;/b&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=35;fontColor=#78909C;" vertex="1" parent="1">
                    <mxGeometry x="740" y="1040" width="120" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-28" value="&lt;font style=&quot;color: rgb(191, 54, 12);&quot;&gt;&lt;b&gt;Fortaleza:&lt;/b&gt; no asume forma&lt;br&gt;funcional; robusto con pocos datos;&lt;br&gt;filtra por 3 familias de parámetros.&lt;br&gt;&lt;b&gt;Limitación:&lt;/b&gt; requiere vecinos&lt;br&gt;dentro del 20 % y ≥ 3 familias.&lt;/font&gt;" style="text;html=1;strokeColor=#E65100;fillColor=#FFF8E1;align=left;verticalAlign=middle;fontSize=35;fontColor=#BF360C;rounded=1;strokeWidth=2;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
                    <mxGeometry x="20" y="1840" width="660" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-29" value="&lt;font style=&quot;color: rgb(13, 71, 161);&quot;&gt;&lt;b&gt;Fortaleza:&lt;/b&gt; captura tendencias&lt;br&gt;globales con validación cruzada;&lt;br&gt;explora 5 familias de modelos.&lt;br&gt;&lt;b&gt;Limitación:&lt;/b&gt; requiere suficientes&lt;br&gt;pares (x, y) y relación funcional.&lt;/font&gt;" style="text;html=1;strokeColor=#1565C0;fillColor=#E3F2FD;align=left;verticalAlign=middle;fontSize=35;fontColor=#0D47A1;rounded=1;strokeWidth=2;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
                    <mxGeometry x="920" y="1840" width="660" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-30" value="&lt;b&gt;Fusión / Selección&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(55, 71, 79);&quot;&gt;Promedio ponderado por confianza (default),&lt;br&gt;o selección por mejor confianza / prioridad.&lt;br&gt;Valor&lt;sub&gt;final&lt;/sub&gt; = Σ (conf&lt;sub&gt;m&lt;/sub&gt; · val&lt;sub&gt;m&lt;/sub&gt;) / Σ conf&lt;sub&gt;m&lt;/sub&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;fontColor=#263238;strokeWidth=6;fontSize=35;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="200" y="2120" width="1200" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-31" style="rounded=1;html=1;strokeWidth=4.8;strokeColor=#E65100;exitX=0.5;exitY=1;entryX=0.25;entryY=0;fontSize=35;" edge="1" parent="1" source="PYzQb3dAYdrDX_y4Gtt2-9" target="PYzQb3dAYdrDX_y4Gtt2-30">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-32" style="rounded=1;html=1;strokeWidth=4.8;strokeColor=#1565C0;exitX=0.5;exitY=1;entryX=0.75;entryY=0;fontSize=35;" edge="1" parent="1" source="PYzQb3dAYdrDX_y4Gtt2-20" target="PYzQb3dAYdrDX_y4Gtt2-30">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-33" value="&lt;font&gt;¿Confianza&lt;br&gt;≥ umbral?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E65100;fontColor=#E65100;strokeWidth=4;fontSize=35;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="620" y="2380" width="360" height="192" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-34" style="rounded=1;html=1;strokeWidth=4;strokeColor=#455A64;fontSize=35;" edge="1" parent="1" source="PYzQb3dAYdrDX_y4Gtt2-30" target="PYzQb3dAYdrDX_y4Gtt2-33">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-35" value="&lt;b&gt;Valor imputado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(84, 110, 122);&quot;&gt;Con trazabilidad: método, ecuación / vecinos,&lt;br&gt;confianza, datos de entrenamiento&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#1B5E20;strokeWidth=6;fontSize=35;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="400" y="2640" width="800" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-36" value="&lt;font style=&quot;color: rgb(46, 125, 50);&quot;&gt;&lt;b&gt;Sí&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;strokeWidth=4.8;strokeColor=#2E7D32;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;fontSize=35;" edge="1" parent="1" source="PYzQb3dAYdrDX_y4Gtt2-33" target="PYzQb3dAYdrDX_y4Gtt2-35">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-37" value="&lt;font&gt;&lt;b&gt;Queda NaN&lt;/b&gt;&lt;br&gt;siguiente iteración&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontColor=#B71C1C;strokeWidth=4;fontSize=35;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1240" y="2400" width="300" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-38" value="&lt;font style=&quot;color: rgb(198, 40, 40);&quot;&gt;&lt;b&gt;No&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;strokeWidth=4;strokeColor=#C62828;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;fontSize=35;" edge="1" parent="1" source="PYzQb3dAYdrDX_y4Gtt2-33" target="PYzQb3dAYdrDX_y4Gtt2-37">
                    <mxGeometry relative="1" as="geometry"/>
