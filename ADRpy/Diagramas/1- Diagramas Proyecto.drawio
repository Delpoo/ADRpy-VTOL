    <diagram id="04tVES4KiRvxdVlDnne9" name="Fig. 3 — Enfoques de imputación (similitud vs regresión) v2">
        <mxGraphModel dx="1116" dy="899" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-1" value="&lt;b&gt;Enfoques de imputación y su rol en el flujo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(84, 110, 122);&quot;&gt;Similitud (filtrado por familias) vs. Regresión univariada&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=35;fontColor=#263238;" vertex="1" parent="1">
                    <mxGeometry x="200" y="20" width="1200" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-2" value="&lt;b&gt;Celda faltante&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(84, 110, 122);&quot;&gt;Aeronave &lt;i&gt;i&lt;/i&gt; × Parámetro &lt;i&gt;j&lt;/i&gt; = NaN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#B71C1C;strokeWidth=6;fontSize=35;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="400" y="200" width="800" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=6;opacity=35;fontSize=35;" vertex="1" parent="1">
                    <mxGeometry x="20" y="460" width="720" height="1500" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-4" value="&lt;b&gt;Enfoque A — Similitud&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=35;fontColor=#E65100;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="472" width="640" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-5" value="&lt;b&gt;1. Perfil del objetivo&lt;/b&gt;&lt;br&gt;&lt;font&gt;Parámetros conocidos de &lt;i&gt;i&lt;/i&gt;&lt;br&gt;clasificados en 3 familias:&lt;br&gt;&lt;b&gt;física · geométrica · prestacional&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E65100;fontColor=#333333;strokeWidth=4;fontSize=35;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="550" width="640" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-6" value="&lt;b&gt;2. Filtrado por diferencia&lt;/b&gt;&lt;br&gt;&lt;font&gt;Por cada candidata con valor en &lt;i&gt;j&lt;/i&gt;:&lt;br&gt;diferencia ≤ 20 % en cada parámetro&lt;br&gt;válido; exigir ≥ 3 familias cubiertas&lt;br&gt;(ó ≥ 2 familias + ≥ 6 parámetros)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E65100;fontColor=#333333;strokeWidth=4;fontSize=35;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="800" width="640" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-7" value="&lt;b&gt;3. Coef. de similitud&lt;/b&gt;&lt;br&gt;&lt;font&gt;Función polinómica por parámetro:&lt;br&gt;sim(x) = a₂ x² + a₁ x + a₀&lt;br&gt;Coef. global = promedio de sim&lt;sub&gt;p&lt;/sub&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E65100;fontColor=#333333;strokeWidth=4;fontSize=35;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="1100" width="640" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-8" value="&lt;b&gt;4. Promedio ponderado&lt;/b&gt;&lt;br&gt;&lt;font&gt;Top-K vecinos (k ∈ [k&lt;sub&gt;min&lt;/sub&gt;, k&lt;sub&gt;max&lt;/sub&gt;])&lt;br&gt;Valor = Σ (sim&lt;sub&gt;k&lt;/sub&gt; · val&lt;sub&gt;k&lt;/sub&gt;) / Σ sim&lt;sub&gt;k&lt;/sub&gt;&lt;br&gt;Conf = sim̄ × (0.7 · pen&lt;sub&gt;k&lt;/sub&gt; + 0.3 · conf&lt;sub&gt;CV&lt;/sub&gt;)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontColor=#333333;strokeWidth=4;fontSize=35;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="1360" width="640" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-9" value="&lt;b&gt;Valor&lt;sub&gt;sim&lt;/sub&gt;&lt;/b&gt;&lt;font&gt; + Confianza + dispersión&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontColor=#E65100;strokeWidth=6;fontSize=35;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="100" y="1660" width="560" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-10" style="rounded=1;html=1;strokeWidth=3.2;strokeColor=#E65100;fontSize=35;" edge="1" parent="1" source="PYzQb3dAYdrDX_y4Gtt2-5" target="PYzQb3dAYdrDX_y4Gtt2-6">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-11" style="rounded=1;html=1;strokeWidth=3.2;strokeColor=#E65100;fontSize=35;" edge="1" parent="1" source="PYzQb3dAYdrDX_y4Gtt2-6" target="PYzQb3dAYdrDX_y4Gtt2-7">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-12" style="rounded=1;html=1;strokeWidth=3.2;strokeColor=#E65100;fontSize=35;" edge="1" parent="1" source="PYzQb3dAYdrDX_y4Gtt2-7" target="PYzQb3dAYdrDX_y4Gtt2-8">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-13" style="rounded=1;html=1;strokeWidth=3.2;strokeColor=#E65100;fontSize=35;" edge="1" parent="1" source="PYzQb3dAYdrDX_y4Gtt2-8" target="PYzQb3dAYdrDX_y4Gtt2-9">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-14" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=6;opacity=35;fontSize=35;" vertex="1" parent="1">
                    <mxGeometry x="860" y="460" width="720" height="1500" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-15" value="&lt;b&gt;Enfoque B — Regresión&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=35;fontColor=#0D47A1;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="900" y="472" width="640" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-16" value="&lt;b&gt;1. Predictores válidos&lt;/b&gt;&lt;br&gt;&lt;font&gt;Columnas con ≥ N datos&lt;br&gt;no constantes para &lt;i&gt;j&lt;/i&gt;;&lt;br&gt;diversidad mínima de valores únicos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D47A1;strokeWidth=4;fontSize=35;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="900" y="550" width="640" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-17" value="&lt;b&gt;2. Ajuste de modelos&lt;/b&gt;&lt;br&gt;&lt;font&gt;5 familias por predictor:&lt;br&gt;lineal · log · exp · potencia · poly₂&lt;br&gt;+ combinaciones de 2 predictores&lt;br&gt;(con chequeos 2D: VIF, PCA, cond)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D47A1;strokeWidth=4;fontSize=35;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="900" y="800" width="640" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-18" value="&lt;b&gt;3. Validación LOOCV&lt;/b&gt;&lt;br&gt;&lt;font&gt;Leave-One-Out por fold:&lt;br&gt;MAPE, R², residuos,&lt;br&gt;coeficiente de variación&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D47A1;strokeWidth=4;fontSize=35;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="900" y="1100" width="640" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-19" value="&lt;b&gt;4. Mejor modelo&lt;/b&gt;&lt;br&gt;&lt;font&gt;Ranking por métrica compuesta&lt;br&gt;→ predicción con ecuación&lt;br&gt;ganadora; confianza basada&lt;br&gt;en R², MAPE y CV residual&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontColor=#0D47A1;strokeWidth=4;fontSize=35;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="900" y="1360" width="640" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-20" value="&lt;b&gt;Valor&lt;sub&gt;reg&lt;/sub&gt;&lt;/b&gt;&lt;font&gt; + Confianza + R² + MAPE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;fontColor=#0D47A1;strokeWidth=6;fontSize=35;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="940" y="1660" width="560" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-21" style="rounded=1;html=1;strokeWidth=3.2;strokeColor=#1565C0;fontSize=35;" edge="1" parent="1" source="PYzQb3dAYdrDX_y4Gtt2-16" target="PYzQb3dAYdrDX_y4Gtt2-17">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-22" style="rounded=1;html=1;strokeWidth=3.2;strokeColor=#1565C0;fontSize=35;" edge="1" parent="1" source="PYzQb3dAYdrDX_y4Gtt2-17" target="PYzQb3dAYdrDX_y4Gtt2-18">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-23" style="rounded=1;html=1;strokeWidth=3.2;strokeColor=#1565C0;fontSize=35;" edge="1" parent="1" source="PYzQb3dAYdrDX_y4Gtt2-18" target="PYzQb3dAYdrDX_y4Gtt2-19">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-24" style="rounded=1;html=1;strokeWidth=3.2;strokeColor=#1565C0;fontSize=35;" edge="1" parent="1" source="PYzQb3dAYdrDX_y4Gtt2-19" target="PYzQb3dAYdrDX_y4Gtt2-20">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="PYzQb3dAYdrDX_y4Gtt2-25" style="rounded=1;html=1;strokeWidth=4.8;strokeColor=#37474F;exitX=0.25;exitY=1;entryX=0.5;entryY=0;fontSize=35;" edge="1" parent="1" source="PYzQb3dAYdrDX_y4Gtt2-2" target="PYzQb3dAYdrDX_y4Gtt2-5">
                    <mxGeometry relative="1" as="geometry"/>
