                <mxCell id="Z1_label" value="&lt;font color=&quot;#2E7D32&quot; style=&quot;font-size:52px&quot;&gt;&lt;b&gt;MÓDULO 1 — PIPELINE DE IMPUTACIÓN DE DATOS&lt;/b&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=52;fontColor=#2E7D32;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="400" y="592" width="1920" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="M1_A" value="🔧 &lt;b&gt;Preprocesamiento&lt;/b&gt;&lt;br&gt;Limpieza, normalización numérica,&lt;br&gt;derivación de variables secundarias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;fontColor=#1B5E20;strokeWidth=8;fontSize=59;align=center;verticalAlign=middle;spacingLeft=24;spacingRight=24;" parent="1" vertex="1">
                    <mxGeometry x="310" y="740" width="1120" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="M1_B" value="🔁 &lt;b&gt;Bucle de imputación iterativa&lt;/b&gt;&lt;br&gt;Para cada celda (Aeronave × Parámetro):&lt;br&gt;entrenar modelos candidatos con datos disponibles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;fontColor=#1B5E20;strokeWidth=8;fontSize=59;align=center;verticalAlign=middle;spacingLeft=24;spacingRight=24;" parent="1" vertex="1">
                    <mxGeometry x="1480" y="740" width="1320" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="M1_C" value="🎲 &lt;b&gt;Selección del mejor modelo&lt;/b&gt;&lt;br&gt;Validación LOOCV, MAPE, R²&lt;br&gt;→ imputar el valor faltante" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;fontColor=#1B5E20;strokeWidth=8;fontSize=59;align=center;verticalAlign=middle;spacingLeft=24;spacingRight=24;" parent="1" vertex="1">
                    <mxGeometry x="2870" y="740" width="1240" height="300" as="geometry"/>
