    <diagram id="ptCjvqQM56CzJJVLL3nw" name="Módulo 2 — Análisis de modelos de imputación">
        <mxGraphModel dx="1116" dy="899" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="_fIsTNc9cakrTyOIAh3u-1" value="📁 &lt;b&gt;ENTRADA: RESULTADOS DEL MÓDULO 1&lt;/b&gt;&lt;br&gt;Archivo JSON con todos los modelos entrenados&lt;br&gt;por cada celda (Aeronave × Parámetro):&lt;br&gt;coeficientes, datos de entrenamiento, métricas,&lt;br&gt;ecuaciones, predictores, tipo de modelo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;fontColor=#0D47A1;strokeWidth=8;fontSize=56;align=center;verticalAlign=middle;spacingLeft=40;spacingRight=40;" vertex="1" parent="1">
                    <mxGeometry x="580" y="80" width="2240" height="370" as="geometry"/>
                </mxCell>
                <mxCell id="_fIsTNc9cakrTyOIAh3u-2" value="🔄 &lt;b&gt;CARGA Y UNIFICACIÓN DE DATOS&lt;/b&gt;&lt;br&gt;• Lectura del JSON con reparación de valores no estándar (NaN, Infinity)&lt;br&gt;• Detección automática de estructura (nueva o antigua)&lt;br&gt;• Separación en dos diccionarios:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;modelos_por_celda&lt;/i&gt; y &lt;i&gt;detalles_por_celda&lt;/i&gt;&lt;br&gt;• Reconstrucción del DataFrame original si no está disponible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;fontColor=#1B5E20;strokeWidth=8;fontSize=56;align=left;verticalAlign=middle;spacingLeft=40;spacingRight=40;" vertex="1" parent="1">
                    <mxGeometry x="580" y="540" width="2240" height="430" as="geometry"/>
                </mxCell>
                <mxCell id="_fIsTNc9cakrTyOIAh3u-3" value="📋 &lt;b&gt;EXTRACCIÓN DEL CATÁLOGO DE FILTROS&lt;/b&gt;&lt;br&gt;Se identifican los valores únicos disponibles:&lt;br&gt;aeronaves, parámetros, tipos de modelo, predictores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;fontColor=#1B5E20;strokeWidth=8;fontSize=56;align=center;verticalAlign=middle;spacingLeft=40;spacingRight=40;" vertex="1" parent="1">
                    <mxGeometry x="580" y="1060" width="2240" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="_fIsTNc9cakrTyOIAh3u-4" value="🎯 &lt;b&gt;SELECCIÓN DE CELDA (AERONAVE × PARÁMETRO)&lt;/b&gt;&lt;br&gt;El usuario elige la combinación a analizar:&lt;br&gt;cada celda contiene un conjunto de modelos candidatos&lt;br&gt;entrenados por el Módulo 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;fontColor=#880E4F;strokeWidth=8;fontSize=56;align=center;verticalAlign=middle;spacingLeft=40;spacingRight=40;" vertex="1" parent="1">
                    <mxGeometry x="580" y="1400" width="2240" height="290" as="geometry"/>
                </mxCell>
                <mxCell id="_fIsTNc9cakrTyOIAh3u-5" value="🔍 &lt;b&gt;ANÁLISIS Y VALIDACIÓN DE MODELOS&lt;/b&gt;&lt;br&gt;Para cada modelo de la celda seleccionada:&lt;br&gt;• Identificar tipo de ecuación y número de predictores&lt;br&gt;• Verificar consistencia ecuación–datos de entrenamiento&lt;br&gt;• Evaluar racionalidad de normalización&lt;br&gt;• Detectar modelos con coeficientes extremos o inestables&lt;br&gt;• Clasificar: ❌ Error crítico (no graficable) · ⚠️ Advertencia (graficable con nota)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E65100;fontColor=#333333;strokeWidth=8;fontSize=56;align=left;verticalAlign=middle;spacingLeft=40;spacingRight=40;" vertex="1" parent="1">
                    <mxGeometry x="480" y="1800" width="2440" height="500" as="geometry"/>
                </mxCell>
                <mxCell id="_fIsTNc9cakrTyOIAh3u-6" value="🎛️ &lt;b&gt;FILTRADO INTERACTIVO&lt;/b&gt;&lt;br&gt;• Predictor específico o todos&lt;br&gt;• Tipos de modelo (lineal, polinómico, log, potencial, exp)&lt;br&gt;• Métodos de imputación (final, similitud, correlación)&lt;br&gt;• Incluir/excluir modelos sin validación LOOCV&lt;br&gt;• Restringir curvas al tramo con datos reales" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;fontColor=#880E4F;strokeWidth=8;fontSize=56;align=left;verticalAlign=middle;spacingLeft=40;spacingRight=40;" vertex="1" parent="1">
                    <mxGeometry x="480" y="2400" width="2440" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="_fIsTNc9cakrTyOIAh3u-7" value="📈 &lt;b&gt;VISTA 2D&lt;/b&gt;&lt;br&gt;&lt;br&gt;Para modelos con 1 predictor:&lt;br&gt;• Curvas ajustadas del modelo&lt;br&gt;• Puntos de entrenamiento reales&lt;br&gt;• Puntos teóricos evaluados&lt;br&gt;• Marcadores de imputación&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(final, similitud, correlación)&lt;br&gt;• Hover con ecuación y métricas&lt;br&gt;• Zoom persistente entre cambios" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;fontColor=#4A148C;strokeWidth=8;fontSize=56;align=left;verticalAlign=top;spacingLeft=40;spacingRight=40;spacingTop=32;" vertex="1" parent="1">
                    <mxGeometry x="220" y="2960" width="950" height="780" as="geometry"/>
                </mxCell>
                <mxCell id="_fIsTNc9cakrTyOIAh3u-8" value="📊 &lt;b&gt;VISTA 3D&lt;/b&gt;&lt;br&gt;&lt;br&gt;Para modelos con 2 predictores:&lt;br&gt;• Superficie del modelo en&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;escala original (desnormalizada)&lt;br&gt;• Puntos de entrenamiento&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;superpuestos en el espacio&lt;br&gt;• Rangos seguros para ejes&lt;br&gt;• Rotación y zoom interactivos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;fontColor=#4A148C;strokeWidth=8;fontSize=56;align=left;verticalAlign=top;spacingLeft=40;spacingRight=40;spacingTop=32;" vertex="1" parent="1">
                    <mxGeometry x="1220" y="2960" width="960" height="780" as="geometry"/>
                </mxCell>
                <mxCell id="_fIsTNc9cakrTyOIAh3u-9" value="📋 &lt;b&gt;MÉTRICAS Y RESUMEN&lt;/b&gt;&lt;br&gt;&lt;br&gt;Indicadores globales:&lt;br&gt;• Total de modelos válidos&lt;br&gt;• Cobertura por tipo de modelo&lt;br&gt;• Distribución de errores&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(MAPE, R²)&lt;br&gt;• Modelos con advertencias&lt;br&gt;• Celdas faltantes o sin modelos&lt;br&gt;• Tabla detallada seleccionable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;fontColor=#4A148C;strokeWidth=8;fontSize=56;align=left;verticalAlign=top;spacingLeft=40;spacingRight=40;spacingTop=32;" vertex="1" parent="1">
                    <mxGeometry x="2230" y="2960" width="880" height="780" as="geometry"/>
                </mxCell>
                <mxCell id="_fIsTNc9cakrTyOIAh3u-10" value="🧠 &lt;b&gt;INTERPRETACIÓN Y TOMA DE DECISIÓN&lt;/b&gt;&lt;br&gt;El usuario evalúa visualmente:&lt;br&gt;• ¿El modelo se ajusta bien a los datos reales?&lt;br&gt;• ¿Hay sobreajuste o extrapolaciones riesgosas?&lt;br&gt;• ¿La confianza reportada es coherente con lo observado?&lt;br&gt;• ¿Qué tipo de modelo es más adecuado para cada celda?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E65100;fontColor=#333333;strokeWidth=8;fontSize=56;align=left;verticalAlign=middle;spacingLeft=40;spacingRight=40;" vertex="1" parent="1">
                    <mxGeometry x="480" y="3880" width="2440" height="430" as="geometry"/>
                </mxCell>
                <mxCell id="_fIsTNc9cakrTyOIAh3u-11" value="📤 &lt;b&gt;EXPORTACIÓN&lt;/b&gt;&lt;br&gt;• Gráficos exportables como PNG&lt;br&gt;• Logs de sesión para auditoría" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#311B92;fontColor=#311B92;strokeWidth=8;fontSize=56;align=center;verticalAlign=middle;spacingLeft=40;spacingRight=40;" vertex="1" parent="1">
                    <mxGeometry x="780" y="4380" width="1840" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="_fIsTNc9cakrTyOIAh3u-12" value="&lt;i&gt;El usuario puede cambiar filtros,&lt;br&gt;celda o tipo de vista en cualquier&lt;br&gt;momento sin perder el contexto&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=56;fontColor=#888888;" vertex="1" parent="1">
                    <mxGeometry x="60" y="2230" width="440" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="_fIsTNc9cakrTyOIAh3u-13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=6;fontSize=56;" edge="1" parent="1" source="_fIsTNc9cakrTyOIAh3u-1" target="_fIsTNc9cakrTyOIAh3u-2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="_fIsTNc9cakrTyOIAh3u-14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=6;fontSize=56;" edge="1" parent="1" source="_fIsTNc9cakrTyOIAh3u-2" target="_fIsTNc9cakrTyOIAh3u-3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="_fIsTNc9cakrTyOIAh3u-15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=6;fontSize=56;" edge="1" parent="1" source="_fIsTNc9cakrTyOIAh3u-3" target="_fIsTNc9cakrTyOIAh3u-4">
                    <mxGeometry relative="1" as="geometry"/>
