                <mxCell id="vhf8ur-TZTeiCWQWOsTu-19" value="&lt;font style=&#39;font-size:28px;color:#2E7D32&#39;&gt;&lt;b&gt;Sí&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;strokeWidth=4.8;strokeColor=#2E7D32;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="vhf8ur-TZTeiCWQWOsTu-12" target="vhf8ur-TZTeiCWQWOsTu-13">
