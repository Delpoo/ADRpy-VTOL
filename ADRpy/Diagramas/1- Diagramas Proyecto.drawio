                <mxCell id="IN" value="&lt;font&gt;📁 &lt;b&gt;BASE DE DATOS eVTOL&lt;/b&gt;&lt;br&gt;Excel con datos heterogéneos de aeronaves:&lt;br&gt;muchos valores faltantes (NaN), unidades mixtas, atípicos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;fontColor=#0D47A1;strokeWidth=8;fontSize=59;align=center;verticalAlign=middle;spacingLeft=40;spacingRight=40;" parent="1" vertex="1">
