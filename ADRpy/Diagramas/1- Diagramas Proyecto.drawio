                <mxCell id="_fIsTNc9cakrTyOIAh3u-26" value="&lt;i&gt;Nuevo análisis&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;dashed=1;dashPattern=32 16;fontSize=56;fontColor=#888888;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="_fIsTNc9cakrTyOIAh3u-10" target="_fIsTNc9cakrTyOIAh3u-6">
