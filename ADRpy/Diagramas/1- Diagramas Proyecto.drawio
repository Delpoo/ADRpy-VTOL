    <diagram id="2wZH83Xohj2PGXAQ1NLw" name="Módulo 3 — Asistente de diseño preliminar">
        <mxGraphModel dx="1966" dy="899" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="F0dO-DQM4wjAOAodGy2t-1" value="📁 &lt;b&gt;ENTRADA: DATASET DE AERONAVES eVTOL&lt;/b&gt;&lt;br&gt;Excel con datos originales + imputados por el Módulo 1:&lt;br&gt;parámetros de masa, geometría, rendimiento,&lt;br&gt;autonomía, alcance, tipo de misión, etc." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;fontColor=#0D47A1;strokeWidth=8;fontSize=44;align=center;verticalAlign=middle;spacingLeft=40;spacingRight=40;" vertex="1" parent="1">
                    <mxGeometry x="580" y="80" width="2240" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="F0dO-DQM4wjAOAodGy2t-2" value="🔄 &lt;b&gt;CARGA Y ESTADÍSTICAS DESCRIPTIVAS&lt;/b&gt;&lt;br&gt;• Lectura del Excel y detección de columnas numéricas útiles&lt;br&gt;• Cálculo por parámetro: n válidos, % NaN, varianza, min, max&lt;br&gt;• Normalización numérica robusta (coma decimal, separadores de miles)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;fontColor=#1B5E20;strokeWidth=8;fontSize=44;align=left;verticalAlign=middle;spacingLeft=40;spacingRight=40;" vertex="1" parent="1">
                    <mxGeometry x="580" y="500" width="2240" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="F0dO-DQM4wjAOAodGy2t-3" value="🎯 &lt;b&gt;DEFINICIÓN DEL DISEÑO OBJETIVO&lt;/b&gt;&lt;br&gt;El usuario configura su aeronave deseada, seleccionando por cada parámetro:&lt;br&gt;• &lt;b&gt;Modo&lt;/b&gt;: fijo (= valor), mínimo (≥), máximo (≤), rango [min..max], o ignorar&lt;br&gt;• &lt;b&gt;Valor numérico&lt;/b&gt; específico (o rango)&lt;br&gt;• &lt;b&gt;Peso relativo&lt;/b&gt; de importancia en la comparación&lt;br&gt;&lt;i&gt;Ej: MTOW=20 kg (fijo, peso 1.0), Payload ≥ 5 kg (mínimo, peso 0.8)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;fontColor=#880E4F;strokeWidth=8;fontSize=44;align=left;verticalAlign=middle;spacingLeft=40;spacingRight=40;" vertex="1" parent="1">
                    <mxGeometry x="480" y="920" width="2440" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="F0dO-DQM4wjAOAodGy2t-4" value="⚙️ &lt;b&gt;CONFIGURACIÓN DE LA COMPARACIÓN&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Segmentación&lt;/b&gt;: global o por tipo de misión (vigilancia, alcance, deportivo…)&lt;br&gt;• &lt;b&gt;α&lt;/b&gt;: exponente de agregación (α=1 promedio; α&gt;1 penaliza desvíos grandes)&lt;br&gt;• &lt;b&gt;Penalización NaN&lt;/b&gt;: castigo por datos faltantes en la comparación&lt;br&gt;• &lt;b&gt;Filtro IQR&lt;/b&gt;: quitar atípicos antes de calcular estadísticos&lt;br&gt;• &lt;b&gt;Top-K&lt;/b&gt;: número de aeronaves más parecidas a considerar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;fontColor=#880E4F;strokeWidth=8;fontSize=44;align=left;verticalAlign=middle;spacingLeft=40;spacingRight=40;" vertex="1" parent="1">
                    <mxGeometry x="480" y="1440" width="2440" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="F0dO-DQM4wjAOAodGy2t-5" value="📐 &lt;b&gt;RANKING POR SIMILITUD&lt;/b&gt;&lt;br&gt;Para cada aeronave del dataset:&lt;br&gt;• Calcular distancia normalizada por escala robusta (IQR/MAD)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;según cada parámetro activo y su modo (fijo, mín, máx, rango)&lt;br&gt;• Agregar: &lt;i&gt;d_total = Σ (peso_i × d_i^α)&lt;/i&gt;&lt;br&gt;• Convertir a similitud: &lt;i&gt;S = exp(−α · d_total)&lt;/i&gt; ∈ [0, 1]&lt;br&gt;• Ordenar de mayor a menor similitud&lt;br&gt;• Insertar fila &lt;b&gt;«Objetivo (usuario)»&lt;/b&gt; como referencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E65100;fontColor=#333333;strokeWidth=8;fontSize=44;align=left;verticalAlign=middle;spacingLeft=40;spacingRight=40;" vertex="1" parent="1">
                    <mxGeometry x="480" y="1960" width="2440" height="520" as="geometry"/>
                </mxCell>
                <mxCell id="F0dO-DQM4wjAOAodGy2t-6" value="🔽 &lt;b&gt;FILTRADO POR RESTRICCIONES&lt;/b&gt;&lt;br&gt;Se obtiene un subconjunto del dataset con las aeronaves&lt;br&gt;que cumplen las reglas (máximos, mínimos, rangos, tolerancias).&lt;br&gt;Este subset alimenta los paneles de análisis." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;fontColor=#1B5E20;strokeWidth=8;fontSize=44;align=center;verticalAlign=middle;spacingLeft=40;spacingRight=40;" vertex="1" parent="1">
                    <mxGeometry x="580" y="2580" width="2240" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="F0dO-DQM4wjAOAodGy2t-7" value="💡 &lt;b&gt;SUGERENCIAS TOP-K&lt;/b&gt;&lt;br&gt;&lt;br&gt;De los K vecinos más parecidos:&lt;br&gt;• Mediana ponderada por distancia&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(&lt;i&gt;w = 1/(1+d)&lt;/i&gt;, vecinos cercanos pesan más)&lt;br&gt;• Rango intercuartil [Q1, Q3]&lt;br&gt;• n efectivo (vecinos útiles)&lt;br&gt;• &lt;b&gt;Alerta&lt;/b&gt; si el objetivo del usuario&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;cae fuera del IQR del Top-K&lt;br&gt;• Histograma + boxplot por parámetro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;fontColor=#4A148C;strokeWidth=8;fontSize=44;align=left;verticalAlign=top;spacingLeft=40;spacingRight=40;spacingTop=32;" vertex="1" parent="1">
                    <mxGeometry x="160" y="3020" width="1000" height="820" as="geometry"/>
                </mxCell>
                <mxCell id="F0dO-DQM4wjAOAodGy2t-8" value="📈 &lt;b&gt;TENDENCIAS X–Y&lt;/b&gt;&lt;br&gt;&lt;br&gt;Exploración bivariada descriptiva:&lt;br&gt;• Nube de puntos + curvas de ajuste&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(lineal, cuadrático, log, exp, potencia)&lt;br&gt;• Métricas: R² ajustado, MAPE (%)&lt;br&gt;• Modo global o por segmento (misión)&lt;br&gt;• Línea de referencia del objetivo&lt;br&gt;• Señal de calidad por tamaño de muestra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;fontColor=#4A148C;strokeWidth=8;fontSize=44;align=left;verticalAlign=top;spacingLeft=40;spacingRight=40;spacingTop=32;" vertex="1" parent="1">
                    <mxGeometry x="1220" y="3020" width="960" height="820" as="geometry"/>
                </mxCell>
                <mxCell id="F0dO-DQM4wjAOAodGy2t-9" value="🔎 &lt;b&gt;DETECCIÓN DE OUTLIERS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Análisis IQR por parámetro:&lt;br&gt;• Vista dual: dataset global&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;vs. dataset filtrado&lt;br&gt;• Límites: [Q1 − k·IQR, Q3 + k·IQR]&lt;br&gt;• Histogramas con marcas de corte&lt;br&gt;• % de atípicos por columna&lt;br&gt;• Resumen tabular con Styler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;fontColor=#4A148C;strokeWidth=8;fontSize=44;align=left;verticalAlign=top;spacingLeft=40;spacingRight=40;spacingTop=32;" vertex="1" parent="1">
                    <mxGeometry x="2240" y="3020" width="820" height="820" as="geometry"/>
                </mxCell>
                <mxCell id="F0dO-DQM4wjAOAodGy2t-10" value="📖 &lt;b&gt;GUÍA CONTEXTUAL POR PARÁMETRO&lt;/b&gt;&lt;br&gt;Panel «info» con vista unificada:&lt;br&gt;• Distribución (histograma + box) sobre la selección actual&lt;br&gt;• Valor objetivo vs. valor sugerido por los Top-K&lt;br&gt;• Indicadores de dispersión y cobertura IQR&lt;br&gt;• Navegación directa a outliers, tendencias o sugerencias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E65100;fontColor=#333333;strokeWidth=8;fontSize=44;align=left;verticalAlign=middle;spacingLeft=40;spacingRight=40;" vertex="1" parent="1">
                    <mxGeometry x="480" y="4000" width="2440" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="F0dO-DQM4wjAOAodGy2t-11" value="🧠 &lt;b&gt;INTERPRETACIÓN Y REFINAMIENTO&lt;/b&gt;&lt;br&gt;El usuario evalúa:&lt;br&gt;• ¿Los vecinos más parecidos son razonables?&lt;br&gt;• ¿Los valores sugeridos son coherentes con las tendencias?&lt;br&gt;• ¿Hay parámetros del objetivo fuera de lo observado? (alertas IQR)&lt;br&gt;→ Si el resultado no es satisfactorio, ajusta parámetros y recalcula" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E65100;fontColor=#333333;strokeWidth=8;fontSize=44;align=left;verticalAlign=middle;spacingLeft=40;spacingRight=40;" vertex="1" parent="1">
                    <mxGeometry x="480" y="4480" width="2440" height="380" as="geometry"/>
                </mxCell>
