<mxfile host="65bd71144e">
    <diagram id="alcance" name="Alcance y Complejidad">
        <mxGraphModel dx="946" dy="1124" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1850" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="TITLE" value="Alcance y complejidad del desarrollo de software" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A237E;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;strokeColor=#1A237E;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1620" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="A_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#C5CAE9;strokeWidth=1;fontSize=18;" parent="1" vertex="1">
                    <mxGeometry x="40" y="95" width="1620" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="A_hdr" value="Visión general" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#283593;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="95" width="1620" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="A_body" value="El presente trabajo no se limitó al análisis teórico: se diseñó, implementó y validó un &lt;b&gt;sistema de software completo&lt;/b&gt; capaz de transformar una base de datos aeronáuticos con celdas faltantes en un dataset confiable, trazable y listo para diseño conceptual.&lt;br&gt;&lt;br&gt;Se compone de &lt;b&gt;tres módulos interdependientes&lt;/b&gt; que cubren desde la predicción estadística hasta la asistencia al ingeniero en la toma de decisiones. Para dimensionar el esfuerzo, se contabilizaron las líneas de código (LOC) excluyendo todo código de terceros." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=18;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="45" y="130" width="1610" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="B_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#A5D6A7;strokeWidth=1;fontSize=18;" parent="1" vertex="1">
                    <mxGeometry x="40" y="285" width="1620" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="B_hdr" value="¿Cuánto código se escribió?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#283593;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="285" width="1620" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="B_num" value="&lt;font color=&quot;#1B5E20&quot;&gt;&lt;b&gt;27,347&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=18;" parent="1" vertex="1">
                    <mxGeometry x="650" y="317" width="400" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="B_sub" value="líneas de código propio  ·  más de 55 archivos Python" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#424242;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="550" y="365" width="600" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="B_M1" value="&lt;b&gt;Módulo 1&lt;/b&gt;&lt;br&gt;&lt;font&gt;&lt;b&gt;10,244&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#E0E0E0&quot;&gt;Pipeline de imputación&lt;br&gt;(correlación + similitud)&lt;/font&gt;&lt;br&gt;&lt;font&gt;&lt;b&gt;37.3 %&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#43A047;fontColor=#FFFFFF;fontSize=18;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=1;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="93" y="395" width="285" height="122" as="geometry"/>
                </mxCell>
                <mxCell id="B_M2" value="&lt;b&gt;Módulo 2&lt;/b&gt;&lt;br&gt;&lt;font&gt;&lt;b&gt;5,694&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#E0E0E0&quot;&gt;Análisis y visualización&lt;br&gt;(aplicación Dash)&lt;/font&gt;&lt;br&gt;&lt;font&gt;&lt;b&gt;20.7 %&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E88E5;fontColor=#FFFFFF;fontSize=18;align=center;verticalAlign=middle;strokeColor=#1565C0;strokeWidth=1;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="400" y="395" width="285" height="122" as="geometry"/>
                </mxCell>
                <mxCell id="B_M3" value="&lt;b&gt;Módulo 3&lt;/b&gt;&lt;br&gt;&lt;font&gt;&lt;b&gt;10,242&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#E0E0E0&quot;&gt;Asistente de diseño&lt;br&gt;preliminar&lt;/font&gt;&lt;br&gt;&lt;font&gt;&lt;b&gt;37.3 %&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B1FA2;fontColor=#FFFFFF;fontSize=18;align=center;verticalAlign=middle;strokeColor=#6A1B9A;strokeWidth=1;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="707" y="395" width="285" height="122" as="geometry"/>
                </mxCell>
                <mxCell id="B_NB" value="&lt;b&gt;Notebooks&lt;/b&gt;&lt;br&gt;&lt;font&gt;&lt;b&gt;557&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#E0E0E0&quot;&gt;Interfaces interactivas&lt;br&gt;de usuario&lt;/font&gt;&lt;br&gt;&lt;font&gt;&lt;b&gt;2.0 %&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;fontColor=#FFFFFF;fontSize=18;align=center;verticalAlign=middle;strokeColor=#BF360C;strokeWidth=1;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="1014" y="395" width="285" height="122" as="geometry"/>
                </mxCell>
                <mxCell id="B_SC" value="&lt;b&gt;Scripts&lt;/b&gt;&lt;br&gt;&lt;font&gt;&lt;b&gt;610&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#E0E0E0&quot;&gt;Orquestación, helpers&lt;br&gt;y utilidades&lt;/font&gt;&lt;br&gt;&lt;font&gt;&lt;b&gt;2.2 %&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#546E7A;fontColor=#FFFFFF;fontSize=18;align=center;verticalAlign=middle;strokeColor=#37474F;strokeWidth=1;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="1321" y="395" width="285" height="122" as="geometry"/>
                </mxCell>
                <mxCell id="C_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFE0B2;strokeWidth=1;fontSize=18;" parent="1" vertex="1">
                    <mxGeometry x="40" y="565" width="1620" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="C_hdr" value="¿Cuánto esfuerzo representa?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#283593;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="565" width="1620" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="C_b1" value="&lt;font&gt;&lt;b&gt;27,347&lt;/b&gt;&lt;/font&gt;&lt;br&gt;líneas de código" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#43A047;strokeWidth=2;fontSize=18;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="155" y="615" width="240" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="C_b2" value="&lt;font&gt;&lt;b&gt;912&lt;/b&gt;&lt;/font&gt;&lt;br&gt;días-persona" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;fontSize=18;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="580" y="615" width="240" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="C_b3" value="&lt;font color=&quot;#B71C1C&quot;&gt;&lt;b&gt;≈ 4.1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;años-persona&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#B71C1C;strokeWidth=2;fontSize=18;align=center;verticalAlign=middle;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="615" width="290" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="C_e1" value="÷ 30 LOC/día" style="rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=18;fontStyle=2;strokeWidth=2;strokeColor=#E65100;labelBackgroundColor=none;" parent="1" source="C_b1" target="C_b2" edge="1">
                    <mxGeometry x="-0.0811" y="19" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="C_e2" value="÷ 220 días/año" style="rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=18;fontStyle=2;strokeWidth=2;strokeColor=#B71C1C;labelBackgroundColor=none;" parent="1" source="C_b2" target="C_b3" edge="1">
                    <mxGeometry x="-0.037" y="19" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="C_rng" value="&lt;font&gt;Rango: &lt;b&gt;3.1 años&lt;/b&gt; (40 LOC/d)  —  &lt;b&gt;6.2 años&lt;/b&gt; (20 LOC/d)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=18;" parent="1" vertex="1">
                    <mxGeometry x="550" y="698" width="600" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="C_ref" value="&lt;font&gt;&lt;i&gt;Ref: COCOMO II (Boehm, 2000); Code Complete (McConnell, 2004)&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#757575;fontSize=18;" parent="1" vertex="1">
                    <mxGeometry x="550" y="720" width="600" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="D_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#F8BBD0;strokeWidth=1;fontSize=18;" parent="1" vertex="1">
                    <mxGeometry x="40" y="775" width="1620" height="550" as="geometry"/>
                </mxCell>
                <mxCell id="D_hdr" value="La &quot;explosión combinatoria&quot;: ¿cuántos modelos se entrenan?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#283593;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="775" width="1620" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="D_ttl" value="&lt;i&gt;Para completar un único archivo Excel con ~100 celdas vacías...&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fillColor=none;strokeColor=none;fontColor=#880E4F;" parent="1" vertex="1">
                    <mxGeometry x="550" y="810" width="600" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="D_s1" value="&lt;b&gt;Paso 1:&lt;/b&gt; 30 parámetros numéricos disponibles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#F48FB1;strokeWidth=1;fontSize=18;fontColor=#212121;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="660" y="837" width="380" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="D_s2" value="&lt;b&gt;Paso 2:&lt;/b&gt; 465 combinaciones de predictores&lt;br&gt;&lt;font&gt;(30 individuales + 435 pares)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#F06292;strokeWidth=1;fontSize=18;fontColor=#212121;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="630" y="907" width="440" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="D_s3" value="&lt;b&gt;Paso 3:&lt;/b&gt; 2,325 modelos candidatos / celda&lt;br&gt;&lt;font&gt;(465 × 5 funciones: lineal, log, exp, potencia, polinomial)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F48FB1;strokeColor=#EC407A;strokeWidth=1;fontSize=18;fontColor=#212121;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="595" y="984" width="510" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="D_s4" value="&lt;b&gt;Paso 4:&lt;/b&gt; 186,000 ajustes / celda&lt;br&gt;&lt;font&gt;(2,325 modelos × 80 entrenamientos LOOCV)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F06292;strokeColor=#E91E63;strokeWidth=2;fontSize=18;fontColor=#FFFFFF;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="565" y="1064" width="570" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="D_s5" value="&lt;b&gt;Paso 5:&lt;/b&gt; 18,600,000 ajustes de regresión&lt;br&gt;&lt;font&gt;(186,000 × 100 celdas faltantes)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E91E63;strokeColor=#C62828;strokeWidth=2;fontSize=18;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="530" y="1141" width="640" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="D_s6" value="&lt;b&gt;Resultado:&lt;/b&gt; ≈ 20,000,000 operaciones&lt;br&gt;&lt;font&gt;(+ verif.: VIF, PCA, cond. number, R², MAPE)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#B71C1C;strokeWidth=3;fontSize=18;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="495" y="1218" width="710" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="D_e1" value="C(30,1) + C(30,2)" style="rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=18;fontStyle=2;strokeWidth=1;strokeColor=#C62828;fontColor=#880E4F;labelBackgroundColor=none;" parent="1" source="D_s1" target="D_s2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="D_e2" value="× 5 funciones" style="rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=18;fontStyle=2;strokeWidth=1;strokeColor=#C62828;fontColor=#880E4F;labelBackgroundColor=none;" parent="1" source="D_s2" target="D_s3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="D_e3" value="× 80 LOOCV" style="rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=18;fontStyle=2;strokeWidth=1;strokeColor=#C62828;fontColor=#880E4F;labelBackgroundColor=none;" parent="1" source="D_s3" target="D_s4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="D_e4" value="× 100 celdas" style="rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=18;fontStyle=2;strokeWidth=1;strokeColor=#C62828;fontColor=#880E4F;labelBackgroundColor=none;" parent="1" source="D_s4" target="D_s5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="D_e5" value="+ verificaciones" style="rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=18;fontStyle=2;strokeWidth=1;strokeColor=#C62828;fontColor=#880E4F;labelBackgroundColor=none;" parent="1" source="D_s5" target="D_s6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="E_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#CE93D8;strokeWidth=1;fontSize=18;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1345" width="1620" height="235" as="geometry"/>
                </mxCell>
                <mxCell id="E_hdr" value="Otros indicadores de complejidad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#283593;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1345" width="1620" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="E_i1" value="&lt;b&gt;55+&lt;/b&gt; archivos Python&lt;br&gt;desarrollados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#9575CD;strokeWidth=1;fontSize=18;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="90" y="1387" width="490" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="E_i2" value="&lt;b&gt;3&lt;/b&gt; módulos interdependientes&lt;br&gt;+ &lt;b&gt;4&lt;/b&gt; bucles de retroalimentación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#9575CD;strokeWidth=1;fontSize=18;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="605" y="1387" width="490" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="E_i3" value="&lt;b&gt;5&lt;/b&gt; familias de funciones estadísticas&lt;br&gt;(lineal, log, exp, potencia, polinomial)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#9575CD;strokeWidth=1;fontSize=18;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="1387" width="490" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="E_i4" value="&lt;b&gt;6&lt;/b&gt; métricas de calidad / modelo&lt;br&gt;(R², MAPE, VIF, PC2, cond. number, rank)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#9575CD;strokeWidth=1;fontSize=18;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="90" y="1477" width="490" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="E_i5" value="&lt;b&gt;2&lt;/b&gt; métodos de detección de outliers&lt;br&gt;(IQR + MAD con pesos adaptativos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#9575CD;strokeWidth=1;fontSize=18;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="605" y="1477" width="490" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="E_i6" value="&lt;b&gt;3&lt;/b&gt; formatos de salida&lt;br&gt;(Excel anotado, JSON trazable, app Dash)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#9575CD;strokeWidth=1;fontSize=18;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="1477" width="490" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="F_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#80CBC4;strokeWidth=1;fontSize=18;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1600" width="1620" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="F_hdr" value="En perspectiva" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#283593;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1600" width="1620" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="F_body" value="El volumen y la complejidad de este desarrollo son comparables a los de &lt;b&gt;herramientas de software científico de uso profesional&lt;/b&gt;. No se trata de un script aislado que «rellena huecos», sino de un &lt;b&gt;ecosistema de herramientas&lt;/b&gt; que automatiza el ciclo completo de imputación, validación, visualización y asistencia al diseño, con trazabilidad en cada paso y múltiples capas de control de calidad estadístico." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=18;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="45" y="1634" width="1610" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="REFS" value="&lt;font color=&quot;#9E9E9E&quot;&gt;&lt;i&gt;Referencias: Boehm, B.W. (2000) Software Cost Estimation with COCOMO II. Prentice Hall.  ·  McConnell, S. (2004) Code Complete, 2nd Ed. Microsoft Press.&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=18;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1750" width="1620" height="30" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>