                <mxCell id="LEG_stays" value="&lt;font style='font-size:26px;'&gt;&lt;b style='color:#0D47A1'&gt;Permanece intacto (núcleo):&lt;/b&gt;&lt;br&gt;• Motor de similitud (filtrado, coeficiente, pesos)&lt;br&gt;• Motor de regresión (modelos, LOOCV, ranking)&lt;br&gt;• Orquestación iterativa y criterios de parada&lt;br&gt;• Cálculo de confianza y manejo de outliers&lt;br&gt;• Fusión, exportación y trazabilidad&lt;/font&gt;" style="text;html=1;strokeColor=#0D47A1;fillColor=#E3F2FD;align=left;verticalAlign=middle;fontSize=26;fontColor=#333333;rounded=1;strokeWidth=3;spacingLeft=20;spacingRight=20;" parent="1" vertex="1">
                    <mxGeometry x="1800" y="3020" width="1580" height="240" as="geometry"/>
                </mxCell>

                <!-- ══════════════════════════════════════════════ -->
                <!-- BOTTOM NOTE -->
                <!-- ══════════════════════════════════════════════ -->
                <mxCell id="BOTTOM_NOTE" value="&lt;font style='font-size:24px;color:#616161'&gt;&lt;i&gt;La arquitectura desacoplada permite migrar el sistema a cualquier dominio con datos tabulares&lt;br&gt;y parámetros numéricos agrupables en familias, sin modificar el motor de imputación.&lt;/i&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontColor=#616161;" parent="1" vertex="1">
                    <mxGeometry x="400" y="3360" width="2800" height="80" as="geometry"/>
                </mxCell>

            </root>
        </mxGraphModel>
