                <!-- ======== MÉTODO A: SIMILITUD ======== -->
                <mxCell id="MA_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;opacity=22;" vertex="1" parent="1">
                    <mxGeometry x="72" y="872" width="1060" height="435" as="geometry"/>
                </mxCell>
                <mxCell id="MA_label" value="&lt;b style=&quot;font-size:12px;color:#004D40&quot;&gt;Método A: Similitud (vecinos)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="90" y="877" width="280" height="18" as="geometry"/>
                </mxCell>

                <mxCell id="MA1" value="&lt;b&gt;Calcular distancia robusta&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Métrica: distancia IQR/MAD normalizada&lt;br&gt;• Entre aeronave objetivo y todas las demás&lt;br&gt;• Solo variables compartidas (no-NaN en ambas)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;fontColor=#004D40;strokeWidth=2;fontSize=10;align=center;" vertex="1" parent="1">
                    <mxGeometry x="105" y="902" width="278" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="MA2" value="&lt;b&gt;Filtrar umbral + Top-K&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Descartar vecinos con d &gt; umbral&lt;br&gt;• Retener los K más cercanos (K=5–10)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;fontColor=#004D40;strokeWidth=2;fontSize=10;align=center;" vertex="1" parent="1">
                    <mxGeometry x="105" y="988" width="278" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="MA3" value="&lt;b&gt;Promedio ponderado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Peso = 1/distancia (inversa)&lt;br&gt;• Mediana ponderada robusta&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;fontColor=#004D40;strokeWidth=2;fontSize=10;align=center;" vertex="1" parent="1">
                    <mxGeometry x="105" y="1067" width="278" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="MA4" value="&lt;b&gt;Calcular C_sim&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Basada en: CV vecinos, n vecinos, dispersión&lt;br&gt;• Penalizaciones: pocos vecinos, alta varianza&lt;br&gt;• C_sim ∈ [0, 1]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2DFDB;strokeColor=#00695C;fontColor=#004D40;strokeWidth=2;fontSize=10;align=center;" vertex="1" parent="1">
                    <mxGeometry x="105" y="1133" width="278" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="MA_OUT" value="&lt;b&gt;Valor_sim + C_sim&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#80CBC4;strokeColor=#004D40;fontColor=#004D40;strokeWidth=2;fontSize=11;align=center;" vertex="1" parent="1">
                    <mxGeometry x="140" y="1210" width="210" height="30" as="geometry"/>
                </mxCell>

                <mxCell id="ma_e1" style="rounded=1;html=1;strokeWidth=2;strokeColor=#00897B;" edge="1" parent="1" source="MA1" target="MA2"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="ma_e2" style="rounded=1;html=1;strokeWidth=2;strokeColor=#00897B;" edge="1" parent="1" source="MA2" target="MA3"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="ma_e3" style="rounded=1;html=1;strokeWidth=2;strokeColor=#00897B;" edge="1" parent="1" source="MA3" target="MA4"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="ma_e4" style="rounded=1;html=1;strokeWidth=2;strokeColor=#00897B;" edge="1" parent="1" source="MA4" target="MA_OUT"><mxGeometry relative="1" as="geometry"/></mxCell>

                <!-- Diamond: suficientes vecinos? -->
                <mxCell id="DEC_VEC" value="¿Suficientes&lt;br&gt;vecinos?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontColor=#E65100;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="470" y="992" width="108" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="ma_dec" style="rounded=1;html=1;strokeWidth=1;strokeColor=#00897B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="MA2" target="DEC_VEC"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="DEC_VEC_NO" value="&lt;font style=&quot;font-size:9px&quot;&gt;Penalizar C_sim&lt;br&gt;o descartar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#E53935;fontColor=#B71C1C;strokeWidth=1;fontSize=9;" vertex="1" parent="1">
                    <mxGeometry x="640" y="1008" width="115" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="dec_vec_no" value="No" style="rounded=1;html=1;strokeWidth=1;strokeColor=#E53935;fontColor=#E53935;fontSize=9;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="DEC_VEC" target="DEC_VEC_NO"><mxGeometry relative="1" as="geometry"/></mxCell>

                <!-- ======== MÉTODO B: CORRELACIÓN ======== -->
                <mxCell id="MB_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=2;opacity=22;" vertex="1" parent="1">
                    <mxGeometry x="1195" y="872" width="780" height="555" as="geometry"/>
                </mxCell>
                <mxCell id="MB_label" value="&lt;b style=&quot;font-size:12px;color:#4A148C&quot;&gt;Método B: Correlación (regresión supervisada)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="1210" y="877" width="380" height="18" as="geometry"/>
                </mxCell>

                <mxCell id="MB1" value="&lt;b&gt;Seleccionar 1–2 predictores&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Máxima correlación con el target&lt;br&gt;• Mayor cobertura (menos NaN)&lt;br&gt;• 1D obligatorio; 2D si hay datos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#4527A0;fontColor=#311B92;strokeWidth=2;fontSize=10;align=center;" vertex="1" parent="1">
                    <mxGeometry x="1225" y="902" width="258" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="MB2" value="&lt;b&gt;Ajustar familias simples&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Lineal, log, exponencial, potencia, poly(≤2)&lt;br&gt;• Complejidad baja → evitar sobreajuste&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#4527A0;fontColor=#311B92;strokeWidth=2;fontSize=10;align=center;" vertex="1" parent="1">
                    <mxGeometry x="1225" y="988" width="258" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="MB3" value="&lt;b&gt;Validación LOOCV&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• MAE, MAPE, R² leave-one-out&lt;br&gt;• Métrica principal: MAPE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#4527A0;fontColor=#311B92;strokeWidth=2;fontSize=10;align=center;" vertex="1" parent="1">
                    <mxGeometry x="1225" y="1074" width="258" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="MB4" value="&lt;b&gt;Penalizaciones&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Por complejidad · Por n pequeño&lt;br&gt;• Por sobreajuste (R²_train ≫ R²_cv)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#4527A0;fontColor=#311B92;strokeWidth=2;fontSize=10;align=center;" vertex="1" parent="1">
                    <mxGeometry x="1225" y="1150" width="258" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="MB5" value="&lt;b&gt;Calcular C_corr&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Base: R²·(1−MAPE/100) − penalizaciones&lt;br&gt;• C_corr ∈ [0, 1]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1C4E9;strokeColor=#4527A0;fontColor=#311B92;strokeWidth=2;fontSize=10;align=center;" vertex="1" parent="1">
                    <mxGeometry x="1225" y="1226" width="258" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="MB_OUT" value="&lt;b&gt;Valor_corr + C_corr&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B39DDB;strokeColor=#311B92;fontColor=#311B92;strokeWidth=2;fontSize=11;align=center;" vertex="1" parent="1">
                    <mxGeometry x="1258" y="1298" width="200" height="30" as="geometry"/>
                </mxCell>

                <mxCell id="mb_e1" style="rounded=1;html=1;strokeWidth=2;strokeColor=#7E57C2;" edge="1" parent="1" source="MB1" target="MB2"><mxGeometry relative="1" as="geometry"/></mxCell>
