                </mxCell>
                <mxCell id="M1_label" value="&lt;b style=&quot;font-size:13px;color:#2E7D32&quot;&gt;MÓDULO 1 — PREDICTOR (Pipeline de Imputación Iterativa)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="72" y="545" width="550" height="20" as="geometry"/>
