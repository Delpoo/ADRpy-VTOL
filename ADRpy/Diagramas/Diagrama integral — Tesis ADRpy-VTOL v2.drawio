                <!-- No → conservar -->
                <mxCell id="SKIP" value="&lt;font style=&quot;font-size:9px&quot;&gt;Conservar valor original&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;fontColor=#37474F;strokeWidth=1;fontSize=9;" vertex="1" parent="1">
