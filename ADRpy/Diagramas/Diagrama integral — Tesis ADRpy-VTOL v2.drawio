                </mxCell>
                <mxCell id="A_label" value="&lt;b style=&quot;font-size:14px;color:#0D47A1&quot;&gt;A — TESIS: CONTEXTO Y MOTIVACIÓN&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="55" y="72" width="450" height="22" as="geometry"/>
                </mxCell>

                <!-- Fila 1: progresión narrativa -->
                <mxCell id="A1" value="&lt;b&gt;Motivación&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Proyecto UTN-FRH: diseñar y&lt;br&gt;construir un dron VTOL ala fija&lt;br&gt;• No existen herramientas integradas&lt;br&gt;para sizing con datos parciales&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D47A1;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="55" y="100" width="220" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="A2" value="&lt;b&gt;Problema inicial&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Dataset UAV incompleto (~60% NaN)&lt;br&gt;• Fuentes heterogéneas y públicas&lt;br&gt;• Specs fragmentadas, sin estándar&lt;br&gt;• Definiciones no comparables&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontColor=#B71C1C;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="310" y="100" width="240" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="A3" value="&lt;b&gt;Necesidad&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Entradas coherentes y verificables&lt;br&gt;para análisis conceptual (ADRpy)&lt;br&gt;• Trazabilidad de cada valor&lt;br&gt;• Confianza cuantificada&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontColor=#E65100;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="585" y="100" width="230" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="A4" value="&lt;b&gt;Decisión de tesis&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Convertir datos dispersos de mercado&lt;br&gt;en insumo trazable para diseño&lt;br&gt;conceptual de aeronaves eVTOL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontColor=#1B5E20;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="850" y="100" width="230" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="A5" value="&lt;b&gt;Arquitectura: 3 módulos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Predictor → Auditor → Design Assist.&lt;br&gt;Pipeline Python modular sobre ADRpy&lt;br&gt;(Sobester &amp;amp; Patterson, Cambridge)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#283593;fontColor=#1A237E;strokeWidth=3;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1115" y="100" width="250" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="A_RES" value="&lt;b&gt;Resultado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Análisis conceptual ejecutable&lt;br&gt;• Trazabilidad completa&lt;br&gt;• Confianza por parámetro&lt;br&gt;• Diagrama T/W vs W/S verificable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#1B5E20;fontColor=#1B5E20;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
