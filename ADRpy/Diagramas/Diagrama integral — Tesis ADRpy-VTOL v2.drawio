                <!-- Fila 3: Enfoque + Solución -->
                <mxCell id="A_ENF" value="&lt;b&gt;Enfoque adoptado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Imputación local por celda (Aeronave × Parámetro)&lt;br&gt;• Dos métodos complementarios fusionados por confianza&lt;br&gt;• Auditoría read-only con clasificación automática&lt;br&gt;• Asistente de diseño con vector etiquetado por origen&lt;br&gt;• Ejecución directa del análisis de restricciones ADRpy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#1B5E20;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="55" y="286" width="500" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="A_SYNTH" value="&lt;b&gt;Solución implementada&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 3 módulos Python acoplados sobre ADRpy&lt;br&gt;• Pipeline de imputación iterativa con convergencia&lt;br&gt;• Confianza C_sim y C_corr independientes&lt;br&gt;• Fusión ponderada + criterios de parada&lt;br&gt;• Trazabilidad JSON completa por celda&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#1B5E20;fontColor=#1B5E20;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
