                <!-- Diamond: celda faltante? -->
                <mxCell id="DEC_CELDA" value="¿Celda&lt;br&gt;faltante?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontColor=#E65100;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
