                <!-- Preprocesamiento (UPDATED: +outlier detection) -->
                <mxCell id="M1_PRE" value="&lt;b&gt;Preprocesamiento&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Limpieza: tipos, duplicados, NaN estructurales&lt;br&gt;• Normalización numérica y de unidades&lt;br&gt;• Derivación de variables secundarias (AR, DL, WL…)&lt;br&gt;• Detección de outliers (IQR / MAD)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;fontColor=#1B5E20;strokeWidth=2;fontSize=11;align=center;" vertex="1" parent="1">
