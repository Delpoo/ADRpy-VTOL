                <!-- ======== FUSIÓN (UPDATED: pesos) ======== -->
                <mxCell id="FUSION" value="&lt;b&gt;FUSIÓN POR CONFIANZA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;V_final = (w_sim·C_sim·V_sim + w_corr·C_corr·V_corr) / Σ&lt;br&gt;• Pesos config: w_sim=0.7, w_corr=0.3&lt;br&gt;• Solo 1 método → usar ese con penalización · Ambos C &lt; umbral → &quot;no imputada&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontColor=#E65100;strokeWidth=3;fontSize=11;align=center;" vertex="1" parent="1">
