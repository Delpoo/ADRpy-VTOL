    <diagram id="tesis_integral_v2" name="Diagrama integral — Tesis ADRpy-VTOL v2">
        <mxGraphModel dx="1400" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="3600" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>

                <!-- ============ TÍTULO ============ -->
                <mxCell id="TITLE" value="&lt;b style=&quot;font-size:18px&quot;&gt;Diagrama Integral — Tesis ADRpy-VTOL&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:12px;color:#546E7A&quot;&gt;Progresión · Sistema Técnico · Integración Macro · Iteración&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontColor=#263238;" vertex="1" parent="1">
                    <mxGeometry x="500" y="10" width="1400" height="48" as="geometry"/>
                </mxCell>

                <!-- ================================================================ -->
                <!--  A — TESIS: CONTEXTO Y MOTIVACIÓN  (y=68 → y=410)               -->
                <!-- ================================================================ -->
                <mxCell id="A_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=3;dashed=1;dashPattern=12 8;opacity=18;" vertex="1" parent="1">
