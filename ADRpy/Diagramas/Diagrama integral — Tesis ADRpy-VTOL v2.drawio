                <mxCell id="B_IN" value="&lt;b&gt;Dataset eVTOL (Excel)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;~30 aeronaves · ~40 parámetros · ~60% NaN&lt;br&gt;Unidades mixtas · Atípicos · Fuentes diversas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;fontColor=#0D47A1;strokeWidth=3;fontSize=11;align=center;" vertex="1" parent="1">
