                <!-- Feedback M2 → M1 (DEC_AUD No → FORK) -->
                <mxCell id="fb_m2" value="&lt;i style=&quot;font-size:9px&quot;&gt;No → Re-entrenar&lt;br&gt;modelos (Módulo 1)&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;dashed=1;dashPattern=10 6;strokeColor=#D32F2F;fontColor=#D32F2F;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="DEC_AUD" target="FORK">
