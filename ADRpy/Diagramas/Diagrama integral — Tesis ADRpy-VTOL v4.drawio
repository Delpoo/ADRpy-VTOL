                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#C5CAE9;strokeWidth=1;fontSize=18;" vertex="1" parent="1">
                    <mxGeometry x="40" y="95" width="1620" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-3" value="Visión general" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#283593;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;spacingLeft=12;" vertex="1" parent="1">
                    <mxGeometry x="40" y="95" width="1620" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-4" value="El presente trabajo no se limitó al análisis teórico: se diseñó, implementó y validó un &lt;b&gt;sistema de software completo&lt;/b&gt; capaz de transformar una base de datos aeronáuticos con celdas faltantes en un dataset confiable, trazable y listo para diseño conceptual.&lt;br&gt;&lt;br&gt;Se compone de &lt;b&gt;tres módulos interdependientes&lt;/b&gt; que cubren desde la predicción estadística hasta la asistencia al ingeniero en la toma de decisiones. Para dimensionar el esfuerzo, se contabilizaron las líneas de código (LOC) excluyendo todo código de terceros." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=18;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="45" y="130" width="1610" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#A5D6A7;strokeWidth=1;fontSize=18;" vertex="1" parent="1">
                    <mxGeometry x="40" y="285" width="1620" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-6" value="¿Cuánto código se escribió?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#283593;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;spacingLeft=12;" vertex="1" parent="1">
                    <mxGeometry x="40" y="285" width="1620" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-7" value="&lt;font color=&quot;#1B5E20&quot;&gt;&lt;b&gt;27,347&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=39;" vertex="1" parent="1">
                    <mxGeometry x="650" y="317" width="400" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-8" value="líneas de código propio  ·  más de 55 archivos Python" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#424242;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="550" y="365" width="600" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-9" value="&lt;b&gt;Módulo 1&lt;/b&gt;&lt;br&gt;&lt;font&gt;&lt;b&gt;10,244&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#E0E0E0&quot;&gt;Pipeline de imputación&lt;br&gt;(correlación + similitud)&lt;/font&gt;&lt;br&gt;&lt;font&gt;&lt;b&gt;37.3 %&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#43A047;fontColor=#FFFFFF;fontSize=18;align=center;verticalAlign=middle;strokeColor=#2E7D32;strokeWidth=1;shadow=1;" vertex="1" parent="1">
                    <mxGeometry x="93" y="395" width="285" height="122" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-10" value="&lt;b&gt;Módulo 2&lt;/b&gt;&lt;br&gt;&lt;font&gt;&lt;b&gt;5,694&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#E0E0E0&quot;&gt;Análisis y visualización&lt;br&gt;(aplicación Dash)&lt;/font&gt;&lt;br&gt;&lt;font&gt;&lt;b&gt;20.7 %&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E88E5;fontColor=#FFFFFF;fontSize=18;align=center;verticalAlign=middle;strokeColor=#1565C0;strokeWidth=1;shadow=1;" vertex="1" parent="1">
