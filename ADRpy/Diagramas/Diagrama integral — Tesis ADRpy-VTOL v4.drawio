                <mxCell id="XSMqS0Mc4mALd_emjHrq-17" value="&lt;font&gt;&lt;b&gt;912&lt;/b&gt;&lt;/font&gt;&lt;br&gt;días-persona" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1">
