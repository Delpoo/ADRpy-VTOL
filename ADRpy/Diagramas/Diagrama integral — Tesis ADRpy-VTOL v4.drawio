                <mxCell id="A_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=3;dashed=1;dashPattern=12 8;opacity=18;arcSize=10;fontSize=12.5;" parent="1" vertex="1">
                    <mxGeometry x="40" y="-110" width="1680" height="400" as="geometry"/>
                </mxCell>
                <mxCell id="A_label" value="&lt;b style=&quot;color: rgb(13, 71, 161);&quot;&gt;A — TESIS: CONTEXTO Y MOTIVACIÓN&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="60" y="-100" width="450" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="A1" value="&lt;font style=&quot;&quot;&gt;&lt;b style=&quot;color: light-dark(rgb(13, 71, 161), rgb(205, 205, 255));&quot;&gt;Motivación&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(13, 71, 161);&quot;&gt;• Diseñar y maquetar un dron VTOL ala fija&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(13, 71, 161);&quot;&gt;•&amp;nbsp;Automatizar proceso de diseño ADRpy&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(13, 71, 161), rgb(205, 205, 255));&quot;&gt;• ADRpy requería ingresar parámetros de aeronaves sin un análisis/validación previa, lo que podía derivar en valores físicamente incoherentes.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D47A1;strokeWidth=2;fontSize=12.5;align=center;verticalAlign=middle;labelBorderColor=none;" parent="1" vertex="1">
                    <mxGeometry x="55" y="-55" width="255" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="A2" value="&lt;font&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(198, 40, 40);&quot;&gt;Problema inicial&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;font&gt;&lt;font style=&quot;color: rgb(198, 40, 40);&quot;&gt;• Dataset UAV incompleto (~60% NaN)&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(198, 40, 40);&quot;&gt;• Datos heterogéneos&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(198, 40, 40);&quot;&gt;• Definiciones no comparables&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontColor=#B71C1C;strokeWidth=2;fontSize=12.5;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="344" y="-55" width="240" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="A3" value="&lt;font style=&quot;&quot;&gt;&lt;b style=&quot;color: light-dark(rgb(249, 168, 37), rgb(237, 237, 237));&quot;&gt;Necesidad&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(249, 168, 37);&quot;&gt;• Entradas coherentes y verificables&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(249, 168, 37);&quot;&gt;para análisis conceptual (ADRpy)&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(249, 168, 37);&quot;&gt;• Completar la tabla de datos con valores lógicos para obtener entendimiento del mercado&lt;/font&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(249, 168, 37), rgb(237, 237, 237));&quot;&gt;• Trazabilidad y confianza de cada valor&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontColor=#E65100;strokeWidth=2;fontSize=12.5;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="622" y="-55" width="230" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="A4" value="&lt;b&gt;&lt;font style=&quot;color: rgb(46, 125, 50);&quot;&gt;Decisión de tesis&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;•&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(46, 125, 50);&quot;&gt;Convertir datos dispersos de mercado&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&lt;font style=&quot;color: rgb(46, 125, 50);&quot;&gt;en insumo trazable para diseño&lt;/font&gt;&lt;/span&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(46, 125, 50);&quot;&gt;conceptual de aeronaves VTOL&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;•&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;&lt;font style=&quot;color: rgb(46, 125, 50);&quot;&gt;Generar una metodología para analisis esos datos y seleccionar valores iniciales&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontColor=#1B5E20;strokeWidth=2;fontSize=12.5;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="887" y="-55" width="250" height="120" as="geometry"/>
