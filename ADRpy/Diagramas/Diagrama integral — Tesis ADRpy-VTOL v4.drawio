                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-16" value="&lt;font&gt;&lt;b&gt;27,347&lt;/b&gt;&lt;/font&gt;&lt;br&gt;líneas de código" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#43A047;strokeWidth=2;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1">
