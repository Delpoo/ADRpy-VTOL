                <mxCell id="TITLE" value="&lt;b&gt;Diagrama Integral ADRpy-VTOL&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=35;fontColor=#263238;" parent="1" vertex="1">
                    <mxGeometry x="40" y="-240" width="1680" height="104" as="geometry"/>
