    <diagram id="wOx7xpxHhQf6B0R2N8oZ" name="Alcance y Complejidad">
        <mxGraphModel dx="3042" dy="1534" grid="1" gridSize="10" guides="0" tooltips="0" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-1" value="Alcance y complejidad del desarrollo de software" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A237E;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;strokeColor=#1A237E;shadow=1;" vertex="1" parent="1">
