                <mxCell id="XSMqS0Mc4mALd_emjHrq-18" value="&lt;font color=&quot;#B71C1C&quot;&gt;&lt;b&gt;≈ 4.1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;años-persona&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#B71C1C;strokeWidth=2;fontSize=23;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
