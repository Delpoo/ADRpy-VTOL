                <mxCell id="MA_label" value="&lt;b style=&quot;color: rgb(0, 77, 64);&quot;&gt;Método A: Similitud (vecinos)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
