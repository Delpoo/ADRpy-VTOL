                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-19" value="÷ 30 LOC/día" style="rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=18;fontStyle=2;strokeWidth=2;strokeColor=#E65100;labelBackgroundColor=none;" edge="1" parent="1" source="XSMqS0Mc4mALd_emjHrq-16" target="XSMqS0Mc4mALd_emjHrq-17">
                    <mxGeometry x="-0.0811" y="19" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-20" value="÷ 220 días/año" style="rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=18;fontStyle=2;strokeWidth=2;strokeColor=#B71C1C;labelBackgroundColor=none;" edge="1" parent="1" source="XSMqS0Mc4mALd_emjHrq-17" target="XSMqS0Mc4mALd_emjHrq-18">
                    <mxGeometry x="-0.037" y="19" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-21" value="&lt;font&gt;Rango: &lt;b&gt;3.1 años&lt;/b&gt; (40 LOC/d)  —  &lt;b&gt;6.2 años&lt;/b&gt; (20 LOC/d)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=18;" vertex="1" parent="1">
                    <mxGeometry x="550" y="698" width="600" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-22" value="&lt;font&gt;&lt;i&gt;Ref: COCOMO II (Boehm, 2000); Code Complete (McConnell, 2004)&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#757575;fontSize=18;" vertex="1" parent="1">
                    <mxGeometry x="550" y="720" width="600" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-23" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#F8BBD0;strokeWidth=1;fontSize=18;" vertex="1" parent="1">
                    <mxGeometry x="40" y="775" width="1620" height="550" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-24" value="La &quot;explosión combinatoria&quot;: ¿cuántos modelos se entrenan?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#283593;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;spacingLeft=12;" vertex="1" parent="1">
                    <mxGeometry x="40" y="775" width="1620" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-25" value="&lt;i&gt;Para completar un único archivo Excel con ~100 celdas vacías...&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fillColor=none;strokeColor=none;fontColor=#880E4F;" vertex="1" parent="1">
                    <mxGeometry x="550" y="810" width="600" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-26" value="&lt;b&gt;Paso 1:&lt;/b&gt; 30 parámetros numéricos disponibles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#F48FB1;strokeWidth=1;fontSize=18;fontColor=#212121;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="660" y="837" width="380" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-27" value="&lt;b&gt;Paso 2:&lt;/b&gt; 465 combinaciones de predictores&lt;br&gt;&lt;font&gt;(30 individuales + 435 pares)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#F06292;strokeWidth=1;fontSize=18;fontColor=#212121;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="630" y="907" width="440" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-28" value="&lt;b&gt;Paso 3:&lt;/b&gt; 2,325 modelos candidatos / celda&lt;br&gt;&lt;font&gt;(465 × 5 funciones: lineal, log, exp, potencia, polinomial)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F48FB1;strokeColor=#EC407A;strokeWidth=1;fontSize=18;fontColor=#212121;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="595" y="984" width="510" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-29" value="&lt;b&gt;Paso 4:&lt;/b&gt; 186,000 ajustes / celda&lt;br&gt;&lt;font&gt;(2,325 modelos × 80 entrenamientos LOOCV)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F06292;strokeColor=#E91E63;strokeWidth=2;fontSize=18;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="565" y="1064" width="570" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-30" value="&lt;b&gt;Paso 5:&lt;/b&gt; 18,600,000 ajustes de regresión&lt;br&gt;&lt;font&gt;(186,000 × 100 celdas faltantes)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E91E63;strokeColor=#C62828;strokeWidth=2;fontSize=18;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
                    <mxGeometry x="530" y="1141" width="640" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-31" value="&lt;b&gt;Resultado:&lt;/b&gt; ≈ 20,000,000 operaciones&lt;br&gt;&lt;font&gt;(+ verif.: VIF, PCA, cond. number, R², MAPE)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#B71C1C;strokeWidth=3;fontSize=18;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
                    <mxGeometry x="495" y="1218" width="710" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-32" value="C(30,1) + C(30,2)" style="rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=18;fontStyle=2;strokeWidth=1;strokeColor=#C62828;fontColor=#880E4F;labelBackgroundColor=none;" edge="1" parent="1" source="XSMqS0Mc4mALd_emjHrq-26" target="XSMqS0Mc4mALd_emjHrq-27">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-33" value="× 5 funciones" style="rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=18;fontStyle=2;strokeWidth=1;strokeColor=#C62828;fontColor=#880E4F;labelBackgroundColor=none;" edge="1" parent="1" source="XSMqS0Mc4mALd_emjHrq-27" target="XSMqS0Mc4mALd_emjHrq-28">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-34" value="× 80 LOOCV" style="rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=18;fontStyle=2;strokeWidth=1;strokeColor=#C62828;fontColor=#880E4F;labelBackgroundColor=none;" edge="1" parent="1" source="XSMqS0Mc4mALd_emjHrq-28" target="XSMqS0Mc4mALd_emjHrq-29">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-35" value="× 100 celdas" style="rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=18;fontStyle=2;strokeWidth=1;strokeColor=#C62828;fontColor=#880E4F;labelBackgroundColor=none;" edge="1" parent="1" source="XSMqS0Mc4mALd_emjHrq-29" target="XSMqS0Mc4mALd_emjHrq-30">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-36" value="+ verificaciones" style="rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=18;fontStyle=2;strokeWidth=1;strokeColor=#C62828;fontColor=#880E4F;labelBackgroundColor=none;" edge="1" parent="1" source="XSMqS0Mc4mALd_emjHrq-30" target="XSMqS0Mc4mALd_emjHrq-31">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-37" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#CE93D8;strokeWidth=1;fontSize=18;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1345" width="1620" height="235" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-38" value="Otros indicadores de complejidad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#283593;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;spacingLeft=12;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1345" width="1620" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-39" value="&lt;b&gt;55+&lt;/b&gt; archivos Python&lt;br&gt;desarrollados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#9575CD;strokeWidth=1;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="90" y="1387" width="490" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-40" value="&lt;b&gt;3&lt;/b&gt; módulos interdependientes&lt;br&gt;+ &lt;b&gt;4&lt;/b&gt; bucles de retroalimentación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#9575CD;strokeWidth=1;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="605" y="1387" width="490" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-41" value="&lt;b&gt;5&lt;/b&gt; familias de funciones estadísticas&lt;br&gt;(lineal, log, exp, potencia, polinomial)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#9575CD;strokeWidth=1;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1120" y="1387" width="490" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-42" value="&lt;b&gt;6&lt;/b&gt; métricas de calidad / modelo&lt;br&gt;(R², MAPE, VIF, PC2, cond. number, rank)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#9575CD;strokeWidth=1;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="90" y="1477" width="490" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-43" value="&lt;b&gt;2&lt;/b&gt; métodos de detección de outliers&lt;br&gt;(IQR + MAD con pesos adaptativos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#9575CD;strokeWidth=1;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="605" y="1477" width="490" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-44" value="&lt;b&gt;3&lt;/b&gt; formatos de salida&lt;br&gt;(Excel anotado, JSON trazable, app Dash)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#9575CD;strokeWidth=1;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1120" y="1477" width="490" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-45" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#80CBC4;strokeWidth=1;fontSize=18;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1600" width="1620" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-46" value="En perspectiva" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#283593;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;spacingLeft=12;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1600" width="1620" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-47" value="El volumen y la complejidad de este desarrollo son comparables a los de &lt;b&gt;herramientas de software científico de uso profesional&lt;/b&gt;. No se trata de un script aislado que «rellena huecos», sino de un &lt;b&gt;ecosistema de herramientas&lt;/b&gt; que automatiza el ciclo completo de imputación, validación, visualización y asistencia al diseño, con trazabilidad en cada paso y múltiples capas de control de calidad estadístico." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=18;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="45" y="1634" width="1610" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="XSMqS0Mc4mALd_emjHrq-48" value="&lt;font color=&quot;#9E9E9E&quot;&gt;&lt;i&gt;Referencias: Boehm, B.W. (2000) Software Cost Estimation with COCOMO II. Prentice Hall.  ·  McConnell, S. (2004) Code Complete, 2nd Ed. Microsoft Press.&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=18;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1750" width="1620" height="30" as="geometry"/>
                </mxCell>
            </root>
