                <mxCell id="XSMqS0Mc4mALd_emjHrq-15" value="¿Cuánto esfuerzo representa?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#283593;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;spacingLeft=12;" vertex="1" parent="1">
