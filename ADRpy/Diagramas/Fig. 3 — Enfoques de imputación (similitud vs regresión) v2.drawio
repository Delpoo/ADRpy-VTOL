<mxfile host="65bd71144e">
    <diagram id="fig_enfoques_v2" name="Enfoques de imputación — Similitud vs Regresión (corregido)">
        <mxGraphModel dx="1900" dy="1840" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2800" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b&gt;Enfoques de imputación y su rol en el flujo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(84, 110, 122);&quot;&gt;Similitud (filtrado por familias) vs. Regresión univariada&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=35;fontColor=#263238;" parent="1" vertex="1">
                    <mxGeometry x="200" y="20" width="1200" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="TRIGGER" value="&lt;b&gt;Celda faltante&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(84, 110, 122);&quot;&gt;Aeronave &lt;i&gt;i&lt;/i&gt; × Parámetro &lt;i&gt;j&lt;/i&gt; = NaN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#B71C1C;strokeWidth=6;fontSize=35;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="400" y="200" width="800" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="SIM_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=6;opacity=35;fontSize=35;" parent="1" vertex="1">
                    <mxGeometry x="20" y="460" width="720" height="1500" as="geometry"/>
                </mxCell>
                <mxCell id="SIM_title" value="&lt;b&gt;Enfoque A — Similitud&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=35;fontColor=#E65100;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="472" width="640" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="SIM_1" value="&lt;b&gt;1. Perfil del objetivo&lt;/b&gt;&lt;br&gt;&lt;font&gt;Parámetros conocidos de &lt;i&gt;i&lt;/i&gt;&lt;br&gt;clasificados en 3 familias:&lt;br&gt;&lt;b&gt;física · geométrica · prestacional&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E65100;fontColor=#333333;strokeWidth=4;fontSize=35;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="550" width="640" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="SIM_2" value="&lt;b&gt;2. Filtrado por diferencia&lt;/b&gt;&lt;br&gt;&lt;font&gt;Por cada candidata con valor en &lt;i&gt;j&lt;/i&gt;:&lt;br&gt;diferencia ≤ 20 % en cada parámetro&lt;br&gt;válido; exigir ≥ 3 familias cubiertas&lt;br&gt;(ó ≥ 2 familias + ≥ 6 parámetros)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E65100;fontColor=#333333;strokeWidth=4;fontSize=35;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="800" width="640" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="SIM_3" value="&lt;b&gt;3. Coef. de similitud&lt;/b&gt;&lt;br&gt;&lt;font&gt;Función polinómica por parámetro:&lt;br&gt;sim(x) = a₂ x² + a₁ x + a₀&lt;br&gt;Coef. global = promedio de sim&lt;sub&gt;p&lt;/sub&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E65100;fontColor=#333333;strokeWidth=4;fontSize=35;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1100" width="640" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="SIM_4" value="&lt;b&gt;4. Promedio ponderado&lt;/b&gt;&lt;br&gt;&lt;font&gt;Top-K vecinos (k ∈ [k&lt;sub&gt;min&lt;/sub&gt;, k&lt;sub&gt;max&lt;/sub&gt;])&lt;br&gt;Valor = Σ (sim&lt;sub&gt;k&lt;/sub&gt; · val&lt;sub&gt;k&lt;/sub&gt;) / Σ sim&lt;sub&gt;k&lt;/sub&gt;&lt;br&gt;Conf = sim̄ × (0.7 · pen&lt;sub&gt;k&lt;/sub&gt; + 0.3 · conf&lt;sub&gt;CV&lt;/sub&gt;)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontColor=#333333;strokeWidth=4;fontSize=35;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1360" width="640" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="SIM_OUT" value="&lt;b&gt;Valor&lt;sub&gt;sim&lt;/sub&gt;&lt;/b&gt;&lt;font&gt; + Confianza + dispersión&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontColor=#E65100;strokeWidth=6;fontSize=35;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="100" y="1660" width="560" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="se1" style="rounded=1;html=1;strokeWidth=3.2;strokeColor=#E65100;fontSize=35;" parent="1" source="SIM_1" target="SIM_2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se2" style="rounded=1;html=1;strokeWidth=3.2;strokeColor=#E65100;fontSize=35;" parent="1" source="SIM_2" target="SIM_3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se3" style="rounded=1;html=1;strokeWidth=3.2;strokeColor=#E65100;fontSize=35;" parent="1" source="SIM_3" target="SIM_4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se4" style="rounded=1;html=1;strokeWidth=3.2;strokeColor=#E65100;fontSize=35;" parent="1" source="SIM_4" target="SIM_OUT" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="REG_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=6;opacity=35;fontSize=35;" parent="1" vertex="1">
                    <mxGeometry x="860" y="460" width="720" height="1500" as="geometry"/>
                </mxCell>
                <mxCell id="REG_title" value="&lt;b&gt;Enfoque B — Regresión&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=35;fontColor=#0D47A1;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="900" y="472" width="640" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="REG_1" value="&lt;b&gt;1. Predictores válidos&lt;/b&gt;&lt;br&gt;&lt;font&gt;Columnas con ≥ N datos&lt;br&gt;no constantes para &lt;i&gt;j&lt;/i&gt;;&lt;br&gt;diversidad mínima de valores únicos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D47A1;strokeWidth=4;fontSize=35;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="900" y="550" width="640" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="REG_2" value="&lt;b&gt;2. Ajuste de modelos&lt;/b&gt;&lt;br&gt;&lt;font&gt;5 familias por predictor:&lt;br&gt;lineal · log · exp · potencia · poly₂&lt;br&gt;+ combinaciones de 2 predictores&lt;br&gt;(con chequeos 2D: VIF, PCA, cond)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D47A1;strokeWidth=4;fontSize=35;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="900" y="800" width="640" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="REG_3" value="&lt;b&gt;3. Validación LOOCV&lt;/b&gt;&lt;br&gt;&lt;font&gt;Leave-One-Out por fold:&lt;br&gt;MAPE, R², residuos,&lt;br&gt;coeficiente de variación&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D47A1;strokeWidth=4;fontSize=35;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="900" y="1100" width="640" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="REG_4" value="&lt;b&gt;4. Mejor modelo&lt;/b&gt;&lt;br&gt;&lt;font&gt;Ranking por métrica compuesta&lt;br&gt;→ predicción con ecuación&lt;br&gt;ganadora; confianza basada&lt;br&gt;en R², MAPE y CV residual&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontColor=#0D47A1;strokeWidth=4;fontSize=35;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="900" y="1360" width="640" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="REG_OUT" value="&lt;b&gt;Valor&lt;sub&gt;reg&lt;/sub&gt;&lt;/b&gt;&lt;font&gt; + Confianza + R² + MAPE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;fontColor=#0D47A1;strokeWidth=6;fontSize=35;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="940" y="1660" width="560" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="re1" style="rounded=1;html=1;strokeWidth=3.2;strokeColor=#1565C0;fontSize=35;" parent="1" source="REG_1" target="REG_2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re2" style="rounded=1;html=1;strokeWidth=3.2;strokeColor=#1565C0;fontSize=35;" parent="1" source="REG_2" target="REG_3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re3" style="rounded=1;html=1;strokeWidth=3.2;strokeColor=#1565C0;fontSize=35;" parent="1" source="REG_3" target="REG_4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re4" style="rounded=1;html=1;strokeWidth=3.2;strokeColor=#1565C0;fontSize=35;" parent="1" source="REG_4" target="REG_OUT" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="split_L" style="rounded=1;html=1;strokeWidth=4.8;strokeColor=#37474F;exitX=0.25;exitY=1;entryX=0.5;entryY=0;fontSize=35;" parent="1" source="TRIGGER" target="SIM_1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="split_R" style="rounded=1;html=1;strokeWidth=4.8;strokeColor=#37474F;exitX=0.75;exitY=1;entryX=0.5;entryY=0;fontSize=35;" parent="1" source="TRIGGER" target="REG_1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="vs_label" value="&lt;font style=&quot;color: rgb(120, 144, 156);&quot;&gt;&lt;b&gt;vs&lt;/b&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=35;fontColor=#78909C;" parent="1" vertex="1">
                    <mxGeometry x="740" y="1040" width="120" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="ann_sim" value="&lt;font style=&quot;color: rgb(191, 54, 12);&quot;&gt;&lt;b&gt;Fortaleza:&lt;/b&gt; no asume forma&lt;br&gt;funcional; robusto con pocos datos;&lt;br&gt;filtra por 3 familias de parámetros.&lt;br&gt;&lt;b&gt;Limitación:&lt;/b&gt; requiere vecinos&lt;br&gt;dentro del 20 % y ≥ 3 familias.&lt;/font&gt;" style="text;html=1;strokeColor=#E65100;fillColor=#FFF8E1;align=left;verticalAlign=middle;fontSize=35;fontColor=#BF360C;rounded=1;strokeWidth=2;spacingLeft=16;spacingRight=16;" parent="1" vertex="1">
                    <mxGeometry x="20" y="1840" width="660" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="ann_reg" value="&lt;font style=&quot;color: rgb(13, 71, 161);&quot;&gt;&lt;b&gt;Fortaleza:&lt;/b&gt; captura tendencias&lt;br&gt;globales con validación cruzada;&lt;br&gt;explora 5 familias de modelos.&lt;br&gt;&lt;b&gt;Limitación:&lt;/b&gt; requiere suficientes&lt;br&gt;pares (x, y) y relación funcional.&lt;/font&gt;" style="text;html=1;strokeColor=#1565C0;fillColor=#E3F2FD;align=left;verticalAlign=middle;fontSize=35;fontColor=#0D47A1;rounded=1;strokeWidth=2;spacingLeft=16;spacingRight=16;" parent="1" vertex="1">
                    <mxGeometry x="920" y="1840" width="660" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="FUSION" value="&lt;b&gt;Fusión / Selección&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(55, 71, 79);&quot;&gt;Promedio ponderado por confianza (default),&lt;br&gt;o selección por mejor confianza / prioridad.&lt;br&gt;Valor&lt;sub&gt;final&lt;/sub&gt; = Σ (conf&lt;sub&gt;m&lt;/sub&gt; · val&lt;sub&gt;m&lt;/sub&gt;) / Σ conf&lt;sub&gt;m&lt;/sub&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;fontColor=#263238;strokeWidth=6;fontSize=35;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="200" y="2120" width="1200" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="fus_L" style="rounded=1;html=1;strokeWidth=4.8;strokeColor=#E65100;exitX=0.5;exitY=1;entryX=0.25;entryY=0;fontSize=35;" parent="1" source="SIM_OUT" target="FUSION" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="fus_R" style="rounded=1;html=1;strokeWidth=4.8;strokeColor=#1565C0;exitX=0.5;exitY=1;entryX=0.75;entryY=0;fontSize=35;" parent="1" source="REG_OUT" target="FUSION" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="DEC" value="&lt;font&gt;¿Confianza&lt;br&gt;≥ umbral?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E65100;fontColor=#E65100;strokeWidth=4;fontSize=35;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="620" y="2380" width="360" height="192" as="geometry"/>
                </mxCell>
                <mxCell id="fus_dec" style="rounded=1;html=1;strokeWidth=4;strokeColor=#455A64;fontSize=35;" parent="1" source="FUSION" target="DEC" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="RESULT" value="&lt;b&gt;Valor imputado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(84, 110, 122);&quot;&gt;Con trazabilidad: método, ecuación / vecinos,&lt;br&gt;confianza, datos de entrenamiento&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#1B5E20;strokeWidth=6;fontSize=35;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="400" y="2640" width="800" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="dec_yes" value="&lt;font style=&quot;color: rgb(46, 125, 50);&quot;&gt;&lt;b&gt;Sí&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;strokeWidth=4.8;strokeColor=#2E7D32;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;fontSize=35;" parent="1" source="DEC" target="RESULT" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="FALLBACK" value="&lt;font&gt;&lt;b&gt;Queda NaN&lt;/b&gt;&lt;br&gt;siguiente iteración&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontColor=#B71C1C;strokeWidth=4;fontSize=35;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1240" y="2400" width="300" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="dec_no" value="&lt;font style=&quot;color: rgb(198, 40, 40);&quot;&gt;&lt;b&gt;No&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;strokeWidth=4;strokeColor=#C62828;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;fontSize=35;" parent="1" source="DEC" target="FALLBACK" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="fb_result" style="rounded=1;html=1;strokeWidth=2;dashed=1;dashPattern=16 12;strokeColor=#C62828;exitX=0.5;exitY=1;entryX=1;entryY=0.5;fontSize=35;" parent="1" source="FALLBACK" target="RESULT" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1390" y="2720"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="split_label" value="&lt;font style=&quot;color: rgb(69, 90, 100);&quot;&gt;&lt;i&gt;Se evalúan ambos enfoques en paralelo&lt;/i&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=35;fontColor=#455A64;labelBackgroundColor=default;" parent="1" vertex="1">
                    <mxGeometry x="300" y="380" width="1000" height="60" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
