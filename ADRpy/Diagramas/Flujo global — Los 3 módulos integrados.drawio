                </mxCell>
                <mxCell id="CONV" value="🧠 &lt;b&gt;INTERPRETACIÓN INTEGRADA&lt;/b&gt;&lt;br&gt;El Módulo 2 confirma que los modelos de imputación son fiables.&lt;br&gt;El Módulo 3 usa los datos imputados para evaluar el espacio de diseño.&lt;br&gt;Ambos informan al ingeniero sobre la &lt;b&gt;calidad&lt;/b&gt; y la &lt;b&gt;factibilidad&lt;/b&gt; del diseño." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;fontColor=#263238;strokeWidth=8;fontSize=60;align=center;verticalAlign=middle;spacingLeft=40;spacingRight=40;" parent="1" vertex="1">
                    <mxGeometry x="970" y="4980" width="2840" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="OUT_REPORT" value="📤 &lt;b&gt;SALIDAS FINALES&lt;/b&gt;&lt;br&gt;• Informe narrativo (Markdown / HTML) con cobertura IQR y alertas&lt;br&gt;• Excel con ranking, sugerencias y detalle Top-K por parámetro&lt;br&gt;• Sesiones guardadas (JSON) para iterar sobre el diseño&lt;br&gt;• Gráficos exportables (PNG) de curvas, superficies y distribuciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#311B92;fontColor=#311B92;strokeWidth=8;fontSize=60;align=left;verticalAlign=middle;spacingLeft=40;spacingRight=40;" parent="1" vertex="1">
                    <mxGeometry x="970" y="5440" width="2840" height="450" as="geometry"/>
                </mxCell>
                <mxCell id="NOTE_ITER" value="&lt;font&gt;&lt;b&gt;CICLO ITERATIVO GLOBAL&lt;/b&gt;&lt;br&gt;&lt;i&gt;Si el Módulo 2 detecta modelos&lt;br&gt;deficientes, se vuelve al Módulo 1&lt;br&gt;para re-entrenar.&lt;br&gt;&lt;br&gt;Si el Módulo 3 revela que el&lt;br&gt;diseño objetivo es inviable, se&lt;br&gt;ajustan restricciones y se repite&lt;br&gt;el ciclo completo.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontColor=#BF360C;strokeWidth=6;fontSize=56;align=center;verticalAlign=middle;spacingLeft=24;spacingRight=24;" parent="1" vertex="1">
