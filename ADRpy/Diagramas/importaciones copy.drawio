<mxfile host="app.diagrams.net" modified="2025-10-15T00:00:00.000Z" agent="ChatGPT" version="22.0.8">
  <diagram id="mitad1_vertical" name="Escalones 0-4 (una línea por paso)">
    <mxGraphModel dx="2200" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <!-- ===== TÍTULO ===== -->
        <mxCell id="ttl" value="Mapa de importación — Escalones 0→4 (una línea por paso; decisiones con salidas separadas)" style="text;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1800" height="30" as="geometry"/>
        </mxCell>

        <!-- ================== ESCALÓN 0 ================== -->
        <mxCell id="E0" value="ESCALÓN 0 — Antes de comprar&#xa;• Definir producto y HS preliminar (con despachante)&#xa;• Chequear permisos posibles (eléctricos, food contact, RF, baterías, etc.)&#xa;• Estimar volumen/frecuencia (FCL/LCL/consolidar)&#xa;⚠️ Hacer esto antes de negociar evita frenos/costos en destino" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="1000" height="90" as="geometry"/>
        </mxCell>

        <!-- ================== ESCALÓN 1 ================== -->
        <mxCell id="E1Q" value="ESCALÓN 1 — ¿Qué Incoterm usar?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="220" height="90" as="geometry"/>
        </mxCell>

        <!-- Incoterms (MISMA LÍNEA / MISMO ESCALÓN) -->
        <mxCell id="E1_EXW" value="EXW (en fábrica)&#xa;• Vendedor NO despacha exportación&#xa;• Comprador retira y exporta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="210" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="E1_FCA" value="FCA (libre transportista)&#xa;• Vendedor SÍ despacha exportación&#xa;• Entrega: fábrica / CFS / terminal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="600" y="210" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="E1_FOB" value="FOB (a bordo)&#xa;• Vendedor exporta y pone a bordo&#xa;• Comprador: flete/seguro/destino" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="900" y="210" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="E1_CFR" value="CFR (costo y flete)&#xa;• Vendedor paga flete a MVD&#xa;• Cargos de destino por cuenta del comprador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1180" y="210" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="E1_CIF" value="CIF (costo, seguro y flete)&#xa;• Como CFR + seguro mínimo del vendedor&#xa;⚠️ Agente del vendedor fija cargos destino (poca negociación)&#xa;⚠️ El riesgo pasa al subir a bordo; considerar seguro propio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1460" y="200" width="340" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="E1_DAP" value="DAP (entregado en destino, sin impuestos)&#xa;• Vendedor lleva hasta tu dirección&#xa;⚠️ Acordar por escrito qué cargos locales incluye" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1820" y="210" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="E1_DDP" value="DDP (todo incluido con impuestos)&#xa;• Vendedor asume todo&#xa;• Se acopla recién al final del flujo (casi sin pasos locales)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="2140" y="210" width="320" height="80" as="geometry"/>
        </mxCell>

        <!-- Conexiones decisión (salidas separadas) -->
        <mxCell id="c1" value="EXW" edge="1" parent="1" source="E1Q" target="E1_EXW"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c2" value="FCA" edge="1" parent="1" source="E1Q" target="E1_FCA"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c3" value="FOB" edge="1" parent="1" source="E1Q" target="E1_FOB"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c4" value="CFR" edge="1" parent="1" source="E1Q" target="E1_CFR"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c5" value="CIF" edge="1" parent="1" source="E1Q" target="E1_CIF"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c6" value="DAP" edge="1" parent="1" source="E1Q" target="E1_DAP"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c7" value="DDP" edge="1" parent="1" source="E1Q" target="E1_DDP"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ================== ESCALÓN 2 ================== -->
        <!-- Sólo se aplica si fue EXW; el resto salta al Escalón 3 o más adelante -->
        <mxCell id="E2_EXW" value="ESCALÓN 2 — (Sólo si EXW)&#xa;• Organizar retiro en fábrica y transporte a CFS/terminal&#xa;• Gestionar despacho de exportación en origen (forwarder)&#xa;• Confirmar cut-off y booking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#42a5f5;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="900" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e2link" edge="1" parent="1" source="E1_EXW" target="E2_EXW"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Saltos explícitos de DAP/DDP (sin pasos intermedios) -->
        <mxCell id="note_DAP" value="DAP: se acopla más adelante, en destino (arribo/terminal). No hay pasos intermedios locales hasta ese punto." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#7cb342;" vertex="1" parent="1">
          <mxGeometry x="1820" y="300" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="note_DDP" value="DDP: se acopla al final (entrega directa). No hay pasos locales intermedios." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#7cb342;" vertex="1" parent="1">
          <mxGeometry x="2140" y="300" width="320" height="60" as="geometry"/>
        </mxCell>

        <!-- ================== ESCALÓN 3 ================== -->
        <mxCell id="E3Q" value="ESCALÓN 3 — ¿Modo de embarque?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="260" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="E3_FCL" value="FCL (contenedor completo)&#xa;• Ventaja: control de unidad&#xa;• Riesgo: demurrage/detention en destino" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#42a5f5;" vertex="1" parent="1">
          <mxGeometry x="340" y="450" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="E3_LCL" value="LCL (consolidado por m³)&#xa;• Sin demurrage de contenedor&#xa;• Cargos CFS por m³ (origen/destino)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#66bb6a;" vertex="1" parent="1">
          <mxGeometry x="700" y="450" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="E3_AIR" value="Aéreo / Exprés (si aplica)&#xa;• Más caro; menos pasos de terminal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#fbc02d;" vertex="1" parent="1">
          <mxGeometry x="1060" y="450" width="320" height="80" as="geometry"/>
        </mxCell>

        <!-- Entradas a E3 desde Incoterms (todas excepto DAP/DDP) y desde EXW -->
        <mxCell id="j1" edge="1" parent="1" source="E1_FCA" target="E3Q"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="j2" edge="1" parent="1" source="E1_FOB" target="E3Q"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="j3" edge="1" parent="1" source="E1_CFR" target="E3Q"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="j4" edge="1" parent="1" source="E1_CIF" target="E3Q"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="j5" edge="1" parent="1" source="E2_EXW" target="E3Q"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Salidas de decisión -->
        <mxCell id="m1" edge="1" parent="1" source="E3Q" target="E3_FCL"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m2" edge="1" parent="1" source="E3Q" target="E3_LCL"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m3" edge="1" parent="1" source="E3Q" target="E3_AIR"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ================== ESCALÓN 4 ================== -->
        <mxCell id="E4Q1" value="ESCALÓN 4 — ¿BL y tipo de release?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="E4_MBLHBL" value="MBL (naviera) / HBL (forwarder)&#xa;• 1 MBL por booking; HBL por proveedor si querés trazabilidad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="380" y="570" width="420" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="E4_RELEASE" value="Release del BL&#xa;• Original (papel) / Telex-Surrender / Express–Sea Waybill&#xa;⚠️ Recomendado: Telex o Express para evitar demoras por papeles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="820" y="560" width="500" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="E4Q2" value="ESCALÓN 4 — ¿Seguro de transporte?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="E4_INS_OWN" value="Seguro propio del comprador&#xa;• Cobertura y atención local a medida" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#66bb6a;" vertex="1" parent="1">
          <mxGeometry x="380" y="690" width="360" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="E4_INS_CIF" value="Seguro del vendedor (CIF)&#xa;• Suele ser mínimo (ICC C)&#xa;⚠️ Si el valor/riesgo es alto, considerá póliza propia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#fbc02d;" vertex="1" parent="1">
          <mxGeometry x="760" y="680" width="420" height="100" as="geometry"/>
        </mxCell>

        <!-- Entradas a E4 desde E3 -->
        <mxCell id="k1" edge="1" parent="1" source="E3_FCL" target="E4Q1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k2" edge="1" parent="1" source="E3_LCL" target="E4Q1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k3" edge="1" parent="1" source="E3_AIR" target="E4Q1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Salidas de E4 decisiones -->
        <mxCell id="k4" edge="1" parent="1" source="E4Q1" target="E4_MBLHBL"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k5" edge="1" parent="1" source="E4Q1" target="E4_RELEASE"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k6" edge="1" parent="1" source="E4Q2" target="E4_INS_OWN"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k7" edge="1" parent="1" source="E4Q2" target="E4_INS_CIF"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
