                <mxCell id="hewICfd9gimmvaOH5mAM-126" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Consolidación en puerto (CFS intraportuario)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=1;verticalAlign=top;" parent="1" vertex="1">
